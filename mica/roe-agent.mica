// Roe's relation-owned, read-only coding agent.
//
// Rust realizes the *Agent* buffer, streaming HTTP, and typeout surfaces. This
// unit owns the transcript, prompt command, tool policy, loop, and rendering
// decisions.

make_identity(:roe/agent)
make_identity(:roe/agent_transcript)
make_identity(:roe/agent_message)
make_identity(:roe/agent_tool)
make_identity(:roe/agent_tool_call)
make_identity(:roe/agent_tool_result)
make_identity(:roe/default_agent)
make_identity(:roe/agent_package)
make_identity(:roe/agent_mode)
make_identity(:roe/agent_chat)
make_identity(:roe/tool_read)
make_identity(:roe/tool_grep)
make_identity(:roe/tool_glob)
make_identity(:roe/tool_ls)

make_relation(:roe/Agent, 1)
make_functional_relation(:roe/AgentModel, 2, [0])
make_functional_relation(:roe/AgentTranscript, 2, [0], :volatile)
make_functional_relation(:roe/AgentView, 2, [0], :volatile)
make_functional_relation(:roe/AgentBuffer, 2, [0], :volatile)
make_functional_relation(:roe/AgentStreaming, 2, [0], :volatile)
make_relation(:roe/AgentMessage, 1, :volatile)
make_functional_relation(:roe/AgentMessageTranscript, 2, [0], :volatile)
make_functional_relation(:roe/AgentMessageSequence, 2, [0], :volatile)
make_functional_relation(:roe/AgentMessageRole, 2, [0], :volatile)
make_functional_relation(:roe/AgentMessageContent, 2, [0], :volatile)
make_functional_relation(:roe/AgentMessageStatus, 2, [0], :volatile)
make_relation(:roe/AgentTool, 1)
make_functional_relation(:roe/AgentToolName, 2, [0])
make_functional_relation(:roe/AgentToolDescription, 2, [0])
make_functional_relation(:roe/AgentToolParameters, 2, [0])
make_relation(:roe/AgentToolEnabled, 2)
make_relation(:roe/AgentToolCall, 1, :volatile)
make_functional_relation(:roe/AgentToolCallMessage, 2, [0], :volatile)
make_functional_relation(:roe/AgentToolCallId, 2, [0], :volatile)
make_functional_relation(:roe/AgentToolCallName, 2, [0], :volatile)
make_functional_relation(:roe/AgentToolCallArguments, 2, [0], :volatile)
make_functional_relation(:roe/AgentToolCallStatus, 2, [0], :volatile)
make_relation(:roe/AgentToolResult, 1, :volatile)
make_functional_relation(:roe/AgentToolResultCall, 2, [0], :volatile)
make_functional_relation(:roe/AgentToolResultContent, 2, [0], :volatile)
make_functional_relation(:roe/AgentToolResultFailed, 2, [0], :volatile)

assert Delegates(#roe/default_agent, #roe/agent, 0)
assert roe/Agent(#roe/default_agent)
assert roe/AgentModel(#roe/default_agent, "deepseek/deepseek-v4-pro")

assert Delegates(#roe/agent_package, #roe/package, 0)
assert roe/Package(#roe/agent_package)
assert roe/PackageUnit(#roe/agent_package, :roe/agent)
assert roe/PackageEnabled(#roe/agent_package, true)

assert Delegates(#roe/agent_mode, #roe/mode, 0)
assert roe/MajorMode(#roe/agent_mode)
assert roe/ModeName(#roe/agent_mode, "agent")
assert roe/ModeKeymap(#roe/agent_mode, #roe/global_map, 100)
assert roe/PackageMode(#roe/agent_package, #roe/agent_mode)

roe/BufferMajorMode(buffer, #roe/agent_mode) :-
  roe/BufferName(buffer, "*Agent*"),
  roe/BufferKind(buffer, :results)

assert Delegates(#roe/agent_chat, #roe/command, 0)
assert roe/Command(#roe/agent_chat)
assert roe/CommandSelector(#roe/agent_chat, :roe/agent_chat)
assert roe/CommandImplementation(#roe/agent_chat, :roe/agent_chat_value)
assert roe/CommandSummary(#roe/agent_chat, "Ask the workspace agent")
assert roe/CommandName(#roe/agent_chat, "agent-chat")
assert roe/CommandArgument(#roe/agent_chat, 2, :prompt, :string)
assert roe/ArgumentPrompt(#roe/agent_chat, 2, "Ask agent")
assert roe/PackageCommand(#roe/agent_package, #roe/agent_chat)

assert roe/AgentTool(#roe/tool_read)
assert roe/AgentToolName(#roe/tool_read, "read")
assert roe/AgentToolDescription(#roe/tool_read, "Read a file relative to the workspace root. Unsaved Roe buffers take precedence over disk.")
assert roe/AgentToolParameters(#roe/tool_read, "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"}},\"required\":[\"path\"]}")
assert roe/AgentToolEnabled(#roe/default_agent, #roe/tool_read)

assert roe/AgentTool(#roe/tool_grep)
assert roe/AgentToolName(#roe/tool_grep, "grep")
assert roe/AgentToolDescription(#roe/tool_grep, "Search workspace text. Unsaved Roe buffers take precedence over disk.")
assert roe/AgentToolParameters(#roe/tool_grep, "{\"type\":\"object\",\"properties\":{\"pattern\":{\"type\":\"string\"},\"limit\":{\"type\":\"integer\"}},\"required\":[\"pattern\"]}")
assert roe/AgentToolEnabled(#roe/default_agent, #roe/tool_grep)

assert roe/AgentTool(#roe/tool_glob)
assert roe/AgentToolName(#roe/tool_glob, "glob")
assert roe/AgentToolDescription(#roe/tool_glob, "Find workspace paths matching *, **, and ? glob patterns.")
assert roe/AgentToolParameters(#roe/tool_glob, "{\"type\":\"object\",\"properties\":{\"pattern\":{\"type\":\"string\"},\"path\":{\"type\":\"string\"}},\"required\":[\"pattern\"]}")
assert roe/AgentToolEnabled(#roe/default_agent, #roe/tool_glob)

assert roe/AgentTool(#roe/tool_ls)
assert roe/AgentToolName(#roe/tool_ls, "ls")
assert roe/AgentToolDescription(#roe/tool_ls, "List files and directories under a workspace path.")
assert roe/AgentToolParameters(#roe/tool_ls, "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"}},\"required\":[]}")
assert roe/AgentToolEnabled(#roe/default_agent, #roe/tool_ls)

// Agent tasks execute with the editor endpoint's ordinary role. Explicit
// grants keep the loop and its host requests discoverable to authority setup.
