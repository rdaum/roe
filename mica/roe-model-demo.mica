// Phase 3 fixture for a complete keymap/command/window workflow. These facts
// stand in for tuples that Phase 4 will assert as endpoint-volatile host state;
// this file is never installed as the durable roe/core unit.

make_identity(:roe/demo_actor)
make_identity(:roe/demo_session)
make_identity(:roe/demo_frame)
make_identity(:roe/demo_buffer)
make_identity(:roe/demo_root_view)
make_identity(:roe/demo_view_a)
make_identity(:roe/demo_view_b)
make_identity(:roe/demo_local_map)
make_identity(:roe/demo_shadow_map)
make_identity(:roe/demo_shadow_command)
make_identity(:roe/demo_package)
make_identity(:roe/demo_disabled_package)
make_identity(:roe/demo_disabled_map)
make_identity(:roe/demo_disabled_command)
make_identity(:roe/demo_disabled_mode)
make_identity(:roe/demo_minor_mode)
make_identity(:roe/demo_parent_face)
make_identity(:roe/demo_child_face)
make_identity(:roe/demo_parent_config)
make_identity(:roe/demo_child_config)

assert Delegates(#roe/demo_local_map, #roe/keymap, 0)
assert Delegates(#roe/demo_shadow_map, #roe/keymap, 0)
assert Delegates(#roe/demo_shadow_command, #roe/command, 0)
assert Delegates(#roe/demo_disabled_map, #roe/keymap, 0)
assert Delegates(#roe/demo_disabled_command, #roe/command, 0)
assert Delegates(#roe/demo_minor_mode, #roe/mode, 0)
assert Delegates(#roe/demo_disabled_mode, #roe/mode, 0)
assert Delegates(#roe/demo_parent_face, #roe/face, 0)
assert Delegates(#roe/demo_child_face, #roe/face, 0)

assert roe/Keymap(#roe/demo_local_map)
assert roe/Keymap(#roe/demo_shadow_map)
assert roe/Keymap(#roe/demo_disabled_map)
assert roe/KeymapParent(#roe/demo_local_map, #roe/global_map)
assert roe/Command(#roe/demo_shadow_command)
assert roe/CommandSelector(#roe/demo_shadow_command, :roe/demo_shadow)
assert roe/CommandSummary(#roe/demo_shadow_command, "Low-priority fixture command")
assert roe/KeyBinding(#roe/demo_shadow_map, "C-x o", #roe/demo_shadow_command, 10)
assert roe/Command(#roe/demo_disabled_command)
assert roe/CommandSelector(#roe/demo_disabled_command, :roe/demo_disabled)
assert roe/CommandSummary(#roe/demo_disabled_command, "Disabled fixture command")
assert roe/KeyBinding(#roe/demo_disabled_map, "C-x o", #roe/demo_disabled_command, 1000)
assert roe/MinorMode(#roe/demo_minor_mode)
assert roe/MinorMode(#roe/demo_disabled_mode)
assert roe/ModeKeymap(#roe/demo_minor_mode, #roe/demo_shadow_map, 0)
assert roe/ModeHook(#roe/fundamental_mode, :after_activate, 100)
assert roe/ModeHook(#roe/demo_minor_mode, :after_edit, 50)
assert roe/ModeHook(#roe/demo_disabled_mode, :disabled_hook, 1000)
assert roe/SyntaxRule(#roe/fundamental_mode, :word, "[[:alnum:]_]", 100)
assert roe/SyntaxRule(#roe/demo_minor_mode, :comment, "//", 50)
assert roe/Face(#roe/demo_parent_face)
assert roe/Face(#roe/demo_child_face)
assert roe/FaceParent(#roe/demo_child_face, #roe/demo_parent_face)
assert roe/FaceAttribute(#roe/demo_parent_face, :foreground, "white")
assert roe/FaceAttribute(#roe/demo_parent_face, :weight, "normal")
assert roe/FaceAttribute(#roe/demo_child_face, :weight, "bold")
assert roe/Configuration(#roe/demo_parent_config, :tab_width, 8)
assert roe/Configuration(#roe/demo_parent_config, :theme, "dark")
assert roe/ConfigurationParent(#roe/demo_child_config, #roe/demo_parent_config)
assert roe/Configuration(#roe/demo_child_config, :tab_width, 4)

assert roe/Package(#roe/demo_package)
assert roe/PackageUnit(#roe/demo_package, :roe/demo_fixture)
assert roe/PackageEnabled(#roe/demo_package, true)
assert roe/PackageCommand(#roe/demo_package, #roe/demo_shadow_command)
assert roe/PackageKeymap(#roe/demo_package, #roe/demo_local_map)
assert roe/PackageKeymap(#roe/demo_package, #roe/demo_shadow_map)
assert roe/PackageMode(#roe/demo_package, #roe/demo_minor_mode)

assert roe/Package(#roe/demo_disabled_package)
assert roe/PackageUnit(#roe/demo_disabled_package, :roe/demo_disabled_fixture)
assert roe/PackageEnabled(#roe/demo_disabled_package, false)
assert roe/PackageCommand(#roe/demo_disabled_package, #roe/demo_disabled_command)
assert roe/PackageKeymap(#roe/demo_disabled_package, #roe/demo_disabled_map)
assert roe/PackageMode(#roe/demo_disabled_package, #roe/demo_disabled_mode)

assert RoleCanInvoke(#roe/editor_role, :roe/demo_shadow)
assert RoleCanInvoke(#roe/editor_role, :roe/demo_policy_probe)

// Phase 4 supplies only these actor/resource associations as volatile endpoint
// tuples. All read/write/invoke/effect/service authority derives from the
// durable editor role in roe/core.
assert roe/ActorRole(#roe/demo_actor, #roe/editor_role)
assert roe/CanUseBuffer(#roe/demo_actor, #roe/demo_buffer)

assert roe/EditorSession(#roe/demo_session)
assert roe/SessionActor(#roe/demo_session, #roe/demo_actor)
assert roe/SessionFrame(#roe/demo_session, #roe/demo_frame)
assert roe/LogicalBuffer(#roe/demo_buffer)
assert roe/BufferName(#roe/demo_buffer, "*demo*")
assert roe/BufferMajorMode(#roe/demo_buffer, #roe/fundamental_mode)
assert roe/Frame(#roe/demo_frame)
assert roe/FrameRootView(#roe/demo_frame, #roe/demo_root_view)
assert roe/View(#roe/demo_root_view)
assert roe/View(#roe/demo_view_a)
assert roe/View(#roe/demo_view_b)
assert roe/ViewFirstChild(#roe/demo_root_view, #roe/demo_view_a)
assert roe/ViewSecondChild(#roe/demo_root_view, #roe/demo_view_b)
assert roe/ViewParent(#roe/demo_view_a, #roe/demo_root_view)
assert roe/ViewParent(#roe/demo_view_b, #roe/demo_root_view)
assert roe/ViewSplitAxis(#roe/demo_root_view, :horizontal)
assert roe/ViewSplitRatio(#roe/demo_root_view, 0.5)
assert roe/ViewBuffer(#roe/demo_view_a, #roe/demo_buffer)
assert roe/ViewBuffer(#roe/demo_view_b, #roe/demo_buffer)
assert roe/ActiveView(#roe/demo_session, #roe/demo_view_a)
assert roe/ViewCursor(#roe/demo_view_a, 0)
assert roe/ViewCursor(#roe/demo_view_b, 0)
assert roe/BufferMajorMode(#roe/demo_buffer, #roe/fundamental_mode)
assert roe/BufferMinorMode(#roe/demo_buffer, #roe/demo_minor_mode)
assert roe/BufferMinorMode(#roe/demo_buffer, #roe/demo_disabled_mode)
assert roe/SessionKeymap(#roe/demo_session, #roe/demo_local_map, 100)
assert roe/SessionKeymap(#roe/demo_session, #roe/demo_disabled_map, 10000)
assert roe/NextView(#roe/demo_view_a, #roe/demo_view_b)
assert roe/NextView(#roe/demo_view_b, #roe/demo_view_a)

verb roe/demo_shadow(actor, session)
  return :wrong_precedence
end

// Exercise the Phase 3 policy relations through the same non-root endpoint as
// dispatch_key. A missing grant, fact, or composition rule changes the result.
verb roe/demo_policy_probe(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  let argument = one roe/CommandArgument(#roe/other_window, 0, ?name, ?kind)
  argument != nothing || return :missing_argument
  let prompt = one roe/ArgumentPrompt(#roe/other_window, 0, ?value)
  prompt != nothing || return :missing_prompt
  let completion = one roe/ArgumentCompletion(#roe/other_window, 0, ?selector)
  completion != nothing || return :missing_completion
  let acquisition = invoke(:roe/acquire_argument, {:actor -> actor, :session -> session, :command -> #roe/other_window, :position -> 0, :supplied -> nothing})
  acquisition[:kind] == :argument_required || return :bad_acquisition
  roe/ArgumentCandidate(:visible_views, actor, session, #roe/demo_view_a, "*demo*") || return :missing_candidate_a
  roe/ArgumentCandidate(:visible_views, actor, session, #roe/demo_view_b, "*demo*") || return :missing_candidate_b
  let selected = invoke(:roe/accept_argument_candidate, {:actor -> actor, :session -> session, :command -> #roe/other_window, :position -> 0, :candidate -> #roe/demo_view_b})
  selected[:value] == #roe/demo_view_b || return :bad_candidate_selection
  roe/DiscoverableCommand(actor, #roe/other_window) || return :not_discoverable
  roe/EffectiveSessionKeymap(session, #roe/demo_shadow_map, 0) || return :missing_mode_keymap
  let disabled_binding = one roe/EffectiveBinding(#roe/demo_disabled_map, "C-x o", ?command, ?precedence)
  disabled_binding == nothing || return :disabled_package_binding
  roe/EffectiveModeHook(#roe/demo_buffer, :after_activate, 100) || return :missing_major_hook
  roe/EffectiveModeHook(#roe/demo_buffer, :after_edit, 50) || return :missing_minor_hook
  let disabled_hook = one roe/EffectiveModeHook(#roe/demo_buffer, :disabled_hook, ?precedence)
  disabled_hook == nothing || return :disabled_package_hook
  roe/EffectiveFaceAttribute(#roe/demo_child_face, :foreground, "white") || return :missing_face_inheritance
  roe/EffectiveFaceAttribute(#roe/demo_child_face, :weight, "bold") || return :missing_face_override
  roe/EffectiveSyntaxRule(#roe/demo_buffer, #roe/fundamental_mode, :word, "[[:alnum:]_]", 100) || return :missing_major_syntax
  roe/EffectiveSyntaxRule(#roe/demo_buffer, #roe/demo_minor_mode, :comment, "//", 50) || return :missing_minor_syntax
  roe/EffectiveConfiguration(#roe/demo_child_config, :tab_width, 4) || return :missing_config_override
  roe/EffectiveConfiguration(#roe/demo_child_config, :theme, "dark") || return :missing_config_inheritance
  return :ok
end
