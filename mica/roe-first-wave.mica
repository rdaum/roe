verb roe/eval_buffer(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  roe/CanRequestService(actor, :mica_filein) || return :mica_filein_denied
  let exactly {:view -> view} = roe/ActiveView(session, ?view)
  let exactly {:buffer -> buffer} = roe/ViewBuffer(view, ?buffer)
  roe/CanUseBuffer(actor, buffer) || return :buffer_denied
  let exactly {:language -> language} = roe/BufferSourceLanguage(buffer, ?language)
  language == :mica || return :not_mica_source
  let exactly {:unit -> unit} = roe/BufferSourceUnit(buffer, ?unit)
  emit(session, {:kind -> :host_action, :action -> :eval_buffer, :buffer -> buffer, :unit -> unit})
  return :ok
end

verb roe/eval_region(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  roe/CanRequestService(actor, :mica_eval) || return :mica_eval_denied
  let exactly {:view -> view} = roe/ActiveView(session, ?view)
  let exactly {:buffer -> buffer} = roe/ViewBuffer(view, ?buffer)
  roe/CanUseBuffer(actor, buffer) || return :buffer_denied
  roe/ViewSelection(view, ?anchor, ?active) || return :no_region
  emit(session, {:kind -> :host_action, :action -> :eval_region, :buffer -> buffer, :view -> view})
  return :ok
end

