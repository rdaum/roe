roe/BufferMajorMode(buffer, #roe/mica_mode) :-
  roe/BufferSourceLanguage(buffer, :mica)

verb roe/insert_current_time(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  let view_rows = roe/ActiveView(session, ?view)
  if not view_rows
    return :no_active_view
  end
  let exactly {:view -> view} = view_rows
  let buffer_rows = roe/ViewBuffer(view, ?buffer)
  if not buffer_rows
    return :no_active_buffer
  end
  let exactly {:buffer -> buffer} = buffer_rows
  roe/CanUseBuffer(actor, buffer) || return :buffer_denied
  roe/CanRequestService(actor, :clock_read) || return :clock_denied
  roe/CanRequestService(actor, :text_write) || return :text_write_denied
  let cursor_rows = roe/ViewCursor(view, ?cursor)
  if not cursor_rows
    return :no_cursor
  end
  let exactly {:cursor -> cursor} = cursor_rows

  let clock = external_request(:clock_millis, {:buffer -> buffer}, 1)
  if clock[:status] != :ok
    raise E_NATIVE, clock[:error]
  end
  let text = string_concat(to_literal(clock[:value]), "\n")
  let mutation = external_request(:text_insert, {:buffer -> buffer, :at -> cursor, :text -> text}, 1)
  if mutation[:status] != :ok
    raise E_NATIVE, mutation[:error]
  end

  let next_cursor = cursor + string_len(text)
  emit(session, {:kind -> :presentation_invalidated, :view -> view, :buffer -> buffer, :cursor -> next_cursor})
  return :inserted
end

