  return :ok
end

verb roe/switch_buffer(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  for found in roe/LogicalBuffer(?buffer)
    if roe/CanUseBuffer(actor, found[:buffer])
      let name = one roe/BufferName(found[:buffer], ?name)
      if name != nothing
        emit(session, {:kind -> :buffer_candidate, :buffer -> found[:buffer], :name -> name})
      end
    end
  end
  emit(session, {:kind -> :host_action, :action -> :switch_buffer})
  return :ok
end

verb roe/kill_buffer(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  for found in roe/LogicalBuffer(?buffer)
    if roe/CanUseBuffer(actor, found[:buffer])
      let name = one roe/BufferName(found[:buffer], ?name)
      if name != nothing
        emit(session, {:kind -> :buffer_candidate, :buffer -> found[:buffer], :name -> name})
      end
    end
  end
  emit(session, {:kind -> :host_action, :action -> :kill_buffer})
  return :ok
end

verb roe/execute_command(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  for found in roe/DiscoverableCommand(actor, ?command)
    let name = one roe/CommandName(found[:command], ?name)
    let action = one roe/CommandHostAction(found[:command], ?action)
    if name != nothing && action != nothing
      emit(session, {:kind -> :command_candidate, :name -> name, :action -> action})
    end
  end
  emit(session, {:kind -> :host_action, :action -> :execute_command})
  return :ok
end

verb roe/isearch_forward(actor, session)
