verb roe/select_window(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  return roe/begin_argument_prompt(actor, session, #roe/select_window, 2)
end

verb roe/begin_argument_prompt(actor, session, command, position)
  let acquisition = invoke(:roe/acquire_argument, {:actor -> actor, :session -> session, :command -> command, :position -> position, :supplied -> none})
  if acquisition == :invalid_completion_type
    return :argument_unavailable
  end
  acquisition[:kind] == :argument_required || return :argument_unavailable
  assert roe/PromptState(session, :command_argument, "", 0, none, some([command, position, acquisition[:value_kind], acquisition[:prompt]]))
  return roe/refresh_prompt(actor, session)
end

verb roe/select_window_value(actor, session, value)
  roe/SessionActor(session, actor) || return :not_session_actor
  roe/SessionLeafView(session, value) || return :invalid_view
  let current_rows = roe/ActiveView(session, ?view)
  if current_rows
    let exactly {:view -> current} = current_rows
    if current != value
      retract roe/ActiveView(session, current)
    end
  end
  assert roe/ActiveView(session, value)
  emit(session, {:kind -> :host_action, :action -> :other_window, :view -> value})
  return :ok
end

verb roe/save_buffer(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  let exactly {:view -> view} = roe/ActiveView(session, ?view)
  let exactly {:buffer -> buffer} = roe/ViewBuffer(view, ?buffer)
  roe/CanUseBuffer(actor, buffer) || return :buffer_denied
  let exactly {:policy -> policy} = roe/BufferSavePolicy(buffer, ?policy)
  if policy == :visited_file
    roe/CanRequestService(actor, :file_write) || return :file_write_denied
    emit(session, {:kind -> :host_action, :action -> :save_buffer, :buffer -> buffer})
    return :ok
  elseif policy == :prompt_destination
    return roe/start_file_prompt(actor, session, :save_file, some(buffer))
  end
  raise E_INVARG, "this buffer cannot be saved"
end

verb roe/quit(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  emit(session, {:kind -> :host_action, :action -> :quit})
  return :ok
end

verb roe/find_file(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  return roe/start_file_prompt(actor, session, :find_file, none)
end

verb roe/visit_file(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  return roe/start_file_prompt(actor, session, :visit_file, none)
end

verb roe/start_file_prompt(actor, session, prompt_kind, aux)
  roe/CanRequestService(actor, :file_read) || return :file_read_denied
  if prompt_kind == :save_file
    roe/CanRequestService(actor, :file_write) || return :file_write_denied
  end
  for old in roe/FileCandidate(session, ?path, ?is_dir)
    retract roe/FileCandidate(session, old[:path], old[:is_dir])
  end
  let listing = external_request(:list_directory, {:path -> "."}, 1)
  if listing[:status] != :ok
    raise E_NATIVE, listing[:error]
  end
  for path in listing[:value]
    assert roe/FileCandidate(session, path, false)
  end
  let exactly {:view -> target} = roe/ActiveView(session, ?view)
  assert roe/PromptState(session, prompt_kind, "", 0, some(target), aux)
  return roe/refresh_prompt(actor, session)
end

verb roe/split_horizontal(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  roe/CanRequestService(actor, :layout_validate) || return :layout_denied
  let exactly {:view -> target} = roe/ActiveView(session, ?view)
  roe/SessionLeafView(session, target) || return :invalid_active_view
  emit(session, {:kind -> :host_action, :action -> :split_horizontal, :view -> target})
  return :ok
end

verb roe/split_vertical(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  roe/CanRequestService(actor, :layout_validate) || return :layout_denied
  let exactly {:view -> target} = roe/ActiveView(session, ?view)
  roe/SessionLeafView(session, target) || return :invalid_active_view
  emit(session, {:kind -> :host_action, :action -> :split_vertical, :view -> target})
  return :ok
end

verb roe/native_other_window(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  let exactly {:view -> current} = roe/ActiveView(session, ?view)
  let next_rows = roe/NextView(current, ?view)
  next_rows || return :no_next_view
  let exactly {:view -> next} = next_rows
  roe/SessionLeafView(session, next) || return :invalid_next_view
  retract roe/ActiveView(session, current)
  assert roe/ActiveView(session, next)
  emit(session, {:kind -> :host_action, :action -> :other_window, :view -> next})
  return :ok
end

verb roe/delete_window(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  roe/CanRequestService(actor, :layout_validate) || return :layout_denied
  let exactly {:view -> target} = roe/ActiveView(session, ?view)
  roe/SessionLeafView(session, target) || return :invalid_active_view
  emit(session, {:kind -> :host_action, :action -> :delete_window, :view -> target})
  return :ok
end

verb roe/delete_other_windows(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  roe/CanRequestService(actor, :layout_validate) || return :layout_denied
  let exactly {:view -> target} = roe/ActiveView(session, ?view)
  roe/SessionLeafView(session, target) || return :invalid_active_view
  emit(session, {:kind -> :host_action, :action -> :delete_other_windows, :view -> target})
  return :ok
end

verb roe/switch_buffer(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  let exactly {:view -> target} = roe/ActiveView(session, ?view)
  assert roe/PromptState(session, :switch_buffer, "", 0, some(target), none)
  return roe/refresh_prompt(actor, session)
end

verb roe/kill_buffer(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  let exactly {:view -> target} = roe/ActiveView(session, ?view)
  assert roe/PromptState(session, :kill_buffer, "", 0, some(target), none)
  return roe/refresh_prompt(actor, session)
end

verb roe/execute_command(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  let exactly {:view -> target} = roe/ActiveView(session, ?view)
  assert roe/PromptState(session, :command, "", 0, some(target), none)
  return roe/refresh_prompt(actor, session)
end

verb roe/list_length(items)
  let count = 0
  for item in items
    count = count + 1
  end
  return count
end

verb roe/prompt_candidates(actor, session, prompt_kind, query)
  let candidates = []
  if prompt_kind == :command
    for found in roe/DiscoverableCommand(actor, ?command)
      let name_rows = roe/CommandName(found[:command], ?name)
      let selector_rows = roe/CommandSelector(found[:command], ?selector)
      if name_rows && selector_rows
        let exactly {:name -> name} = name_rows
        let exactly {:selector -> selector} = selector_rows
        if (query == "" || string_contains(lower(name), lower(query))) && roe/list_length(candidates) < 256
          candidates = [@candidates, [name, selector]]
        end
      end
    end
  elseif prompt_kind == :switch_buffer || prompt_kind == :kill_buffer
    for found in roe/LogicalBuffer(?buffer)
      if roe/CanUseBuffer(actor, found[:buffer])
        let name_rows = roe/BufferName(found[:buffer], ?name)
        let kind_rows = roe/BufferKind(found[:buffer], ?buffer_kind)
        if name_rows && kind_rows
          let exactly {:name -> name} = name_rows
          let exactly {:buffer_kind -> buffer_kind} = kind_rows
          let selection_rows = roe/BufferSelectionPolicy(buffer_kind, ?policy)
          if selection_rows
            let exactly {:policy -> selection_policy} = selection_rows
            if selection_policy == :allow && (query == "" || string_contains(lower(name), lower(query))) && roe/list_length(candidates) < 256
              candidates = [@candidates, [name, found[:buffer]]]
            end
          end
        end
      end
    end
  elseif prompt_kind == :find_file || prompt_kind == :visit_file || prompt_kind == :save_file
    for found in roe/FileCandidate(session, ?path, ?is_dir)
      if query == "" || string_contains(lower(found[:path]), lower(query))
        if roe/list_length(candidates) < 256
          candidates = [@candidates, [found[:path], found[:path]]]
        end
      end
    end
  elseif prompt_kind == :command_argument
    let state_rows = roe/PromptState(session, _, _, _, _, ?aux)
    if state_rows
      let exactly {:aux -> aux} = state_rows
      if aux
        let exactly {:value -> command_state} = aux
        let completion_rows = roe/ArgumentCompletion(command_state[0], command_state[1], ?selector)
        if completion_rows
          let exactly {:selector -> completion} = completion_rows
          for found in roe/ArgumentCandidate(completion, actor, session, ?candidate, ?label)
            if query == "" || string_contains(lower(found[:label]), lower(query))
              if roe/list_length(candidates) < 256
                candidates = [@candidates, [found[:label], found[:candidate]]]
              end
            end
          end
        end
      end
    end
  end
  return sort(candidates)
end

verb roe/refresh_prompt(actor, session)
  let state_rows = roe/PromptState(session, ?prompt_kind, ?query, ?state_selected, ?target, ?aux)
  state_rows || return :no_prompt
  let exactly {:prompt_kind -> prompt_kind, :query -> query, :state_selected -> state_selected, :target -> target, :aux -> aux} = state_rows
  let candidates = roe/prompt_candidates(actor, session, prompt_kind, query)
  let selected = state_selected
  if roe/list_length(candidates) == 0
    selected = 0
  elseif selected >= roe/list_length(candidates)
    selected = roe/list_length(candidates) - 1
  end
  if selected != state_selected
    retract roe/PromptState(session, _, _, _, _, _)
    assert roe/PromptState(session, prompt_kind, query, selected, target, aux)
  end
  let prompt = ""
  if prompt_kind == :command_argument
    let exactly {:value -> command_state} = aux
    prompt = command_state[3]
    emit(session, {:kind -> :prompt_update, :prompt_kind -> prompt_kind, :value_kind -> command_state[2], :prompt -> prompt, :query -> query, :selected -> selected, :candidates -> candidates})
  else
    emit(session, {:kind -> :prompt_update, :prompt_kind -> prompt_kind, :prompt -> prompt, :query -> query, :selected -> selected, :candidates -> candidates})
  end
  return :ok
end

verb roe/prompt_key(actor, session, sequence)
  let state_rows = roe/PromptState(session, ?prompt_kind, ?state_query, ?state_selected, ?target, ?aux)
  state_rows || return :no_prompt
  let exactly {:prompt_kind -> prompt_kind, :state_query -> state_query, :state_selected -> state_selected, :target -> target, :aux -> aux} = state_rows
  if roe/KeyPrefix(sequence)
    return :prefix
  end
  let global_command = none
  let global_precedence = -2147483648
  let global_ambiguous = false
  for active in roe/EffectiveSessionKeymap(session, ?keymap, ?session_precedence)
    for binding in roe/EffectiveBinding(active[:keymap], sequence, ?command, ?precedence)
      let precedence = active[:session_precedence] + binding[:precedence]
      if not global_command || precedence > global_precedence
        global_command = some(binding[:command])
        global_precedence = precedence
        global_ambiguous = false
      elseif precedence == global_precedence
        let exactly {:value -> current_global_command} = global_command
        if current_global_command != binding[:command]
          global_ambiguous = true
        end
      end
    end
  end
  if global_command
    let exactly {:value -> command} = global_command
    if roe/PromptGlobalCommand(command)
      if global_ambiguous
        raise E_AMBIGUOUS, "ambiguous prompt-global key binding"
      end
      let selector_rows = roe/CommandSelector(command, ?selector)
      selector_rows || return :missing_prompt_global_selector
      let exactly {:selector -> global_selector} = selector_rows
      return invoke(global_selector, {:actor -> actor, :session -> session})
    end
  end
  if prompt_kind == :isearch_forward || prompt_kind == :isearch_backward
    return roe/search_prompt_key(actor, session, sequence)
  end
  let query = state_query
  let selected = state_selected
  let candidates = roe/prompt_candidates(actor, session, prompt_kind, query)
  if sequence == "Esc" || sequence == "C-g"
    retract roe/PromptState(session, _, _, _, _, _)
    emit(session, {:kind -> :prompt_close})
    return :cancelled
  elseif sequence == "⌫"
    if string_len(query) > 0
      query = string_slice(query, 0, string_len(query) - 1)
    end
    selected = 0
  elseif sequence == "↑" || sequence == "C-p"
    if selected > 0
      selected = selected - 1
    end
  elseif sequence == "↓" || sequence == "C-n"
    if selected + 1 < roe/list_length(candidates)
      selected = selected + 1
    end
  elseif sequence == "⏎"
    let chosen_option = none
    if roe/list_length(candidates) > 0
      chosen_option = some(candidates[selected])
    elseif prompt_kind == :switch_buffer && query != ""
      let exactly {:policy -> creation_policy} = roe/BufferCreationPolicy(:ordinary, ?policy)
      creation_policy == :allow || return :creation_denied
      retract roe/PromptState(session, _, _, _, _, _)
      emit(session, {:kind -> :prompt_close})
      let exactly {:value -> target_view} = target
      emit(session, {:kind -> :host_action, :action -> :create_buffer, :buffer_name -> query, :view -> target_view})
      return :ok
    elseif (prompt_kind == :find_file || prompt_kind == :visit_file || prompt_kind == :save_file) && query != ""
      chosen_option = some([query, query])
    else
      return roe/refresh_prompt(actor, session)
    end
    let exactly {:value -> chosen} = chosen_option
    retract roe/PromptState(session, _, _, _, _, _)
    emit(session, {:kind -> :prompt_close})
    if target
      let exactly {:value -> target_view} = target
      let current_rows = roe/ActiveView(session, ?view)
      if current_rows
        let exactly {:view -> current} = current_rows
        if current != target_view
          retract roe/ActiveView(session, current)
          assert roe/ActiveView(session, target_view)
        end
      end
    end
    if prompt_kind == :command
      return invoke(chosen[1], {:actor -> actor, :session -> session})
    elseif prompt_kind == :switch_buffer
      emit(session, {:kind -> :host_action, :action -> :switch_buffer_selected, :buffer -> chosen[1]})
      return :ok
    elseif prompt_kind == :kill_buffer
      return roe/request_kill_buffer(actor, session, chosen[1])
    elseif prompt_kind == :find_file
      roe/CanRequestService(actor, :file_read) || return :file_read_denied
      emit(session, {:kind -> :host_action, :action -> :find_file_selected, :path -> chosen[1]})
      return :ok
    elseif prompt_kind == :visit_file
      roe/CanRequestService(actor, :file_read) || return :file_read_denied
      emit(session, {:kind -> :host_action, :action -> :visit_file_selected, :path -> chosen[1]})
      return :ok
    elseif prompt_kind == :save_file
      roe/CanRequestService(actor, :file_write) || return :file_write_denied
      let exactly {:value -> save_buffer} = aux
      emit(session, {:kind -> :host_action, :action -> :save_buffer_as_selected, :buffer -> save_buffer, :path -> chosen[1]})
      return :ok
    elseif prompt_kind == :command_argument
      let exactly {:value -> command_state} = aux
      let accepted = invoke(:roe/accept_argument_candidate, {:actor -> actor, :session -> session, :command -> command_state[0], :position -> command_state[1], :candidate -> chosen[1]})
      accepted[:kind] == :argument_value || return :invalid_argument
      let implementation_rows = roe/CommandImplementation(command_state[0], ?selector)
      implementation_rows || return :missing_implementation
      let exactly {:selector -> implementation} = implementation_rows
      return invoke(implementation, {:actor -> actor, :session -> session, :value -> accepted[:value]})
    end
  elseif string_len(sequence) == 1
    query = string_concat(query, sequence)
    selected = 0
  else
    return :handled
  end
  retract roe/PromptState(session, _, _, _, _, _)
  assert roe/PromptState(session, prompt_kind, query, selected, target, aux)
  return roe/refresh_prompt(actor, session)
end

verb roe/request_kill_buffer(actor, session, buffer)
  roe/SessionActor(session, actor) || return :not_session_actor
  roe/CanUseBuffer(actor, buffer) || return :buffer_denied
  let exactly {:policy -> policy} = roe/BufferKillPolicy(buffer, ?policy)
  if policy == :allow
    emit(session, {:kind -> :host_action, :action -> :kill_buffer_selected, :buffer -> buffer})
    return :ok
  elseif policy == :deny_modified
    raise E_INVARG, "buffer is modified; save it before killing"
  end
  raise E_INVARG, "special buffer cannot be killed"
end

verb roe/isearch_forward(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  return roe/start_search(actor, session, :isearch_forward)
end

verb roe/isearch_backward(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  return roe/start_search(actor, session, :isearch_backward)
end

verb roe/start_search(actor, session, prompt_kind)
  roe/CanRequestService(actor, :text_read) || return :text_read_denied
  let exactly {:view -> target} = roe/ActiveView(session, ?view)
  let exactly {:cursor -> original} = roe/ViewCursor(target, ?cursor)
  let previous = ""
  let previous_rows = roe/PromptLast(session, :search, ?query)
  if previous_rows
    let exactly {:query -> previous_query} = previous_rows
    previous = previous_query
  end
  assert roe/PromptState(session, prompt_kind, previous, 0, some(target), some(original))
  return roe/refresh_search(actor, session)
end

verb roe/refresh_search(actor, session)
  let state_rows = roe/PromptState(session, ?prompt_kind, ?query, ?state_selected, ?target, ?aux)
  state_rows || return :no_prompt
  let exactly {:prompt_kind -> prompt_kind, :query -> query, :state_selected -> state_selected, :target -> target, :aux -> aux} = state_rows
  let exactly {:value -> target_view} = target
  let buffer_rows = roe/ViewBuffer(target_view, ?buffer)
  buffer_rows || return :no_buffer
  let exactly {:buffer -> buffer} = buffer_rows
  let result = external_request(:text_search, {:buffer -> buffer, :query -> query}, 1)
  if result[:status] != :ok
    raise E_NATIVE, result[:error]
  end
  let matches = result[:value]
  let selected = state_selected
  let count = roe/list_length(matches)
  if count == 0
    selected = 0
  elseif selected >= count
    selected = count - 1
  end
  if selected != state_selected
    retract roe/PromptState(session, _, _, _, _, _)
    assert roe/PromptState(session, prompt_kind, query, selected, target, aux)
  end
  emit(session, {:kind -> :prompt_update, :prompt_kind -> prompt_kind, :query -> query, :selected -> selected, :candidates -> []})
  emit(session, {:kind -> :search_update, :view -> target_view, :matches -> matches, :selected -> selected})
  return :ok
end

verb roe/search_prompt_key(actor, session, sequence)
  let state_rows = roe/PromptState(session, ?prompt_kind, ?state_query, ?state_selected, ?target, ?aux)
  state_rows || return :no_prompt
  let exactly {:prompt_kind -> prompt_kind, :state_query -> state_query, :state_selected -> state_selected, :target -> target, :aux -> aux} = state_rows
  let exactly {:value -> target_view} = target
  let exactly {:value -> original_cursor} = aux
  let query = state_query
  let selected = state_selected
  if sequence == "Esc" || sequence == "C-g"
    retract roe/PromptState(session, _, _, _, _, _)
    emit(session, {:kind -> :search_finish, :view -> target_view, :original -> original_cursor, :query -> state_query, :accepted -> false})
    emit(session, {:kind -> :prompt_close})
    return :cancelled
  elseif sequence == "⏎"
    let previous_rows = roe/PromptLast(session, :search, ?previous)
    if previous_rows
      let exactly {:previous -> previous} = previous_rows
      retract roe/PromptLast(session, :search, previous)
    end
    assert roe/PromptLast(session, :search, state_query)
    retract roe/PromptState(session, _, _, _, _, _)
    emit(session, {:kind -> :search_finish, :view -> target_view, :original -> original_cursor, :query -> state_query, :accepted -> true})
    emit(session, {:kind -> :prompt_close})
    return :accepted
  elseif sequence == "⌫"
    if string_len(query) > 0
      query = string_slice(query, 0, string_len(query) - 1)
    end
    selected = 0
  elseif sequence == "C-s" || sequence == "↓"
    selected = selected + 1
  elseif sequence == "C-r" || sequence == "↑"
    if selected > 0
      selected = selected - 1
    end
  elseif string_len(sequence) == 1
    query = string_concat(query, sequence)
    selected = 0
  else
    return :handled
  end
  retract roe/PromptState(session, _, _, _, _, _)
  assert roe/PromptState(session, prompt_kind, query, selected, target, aux)
  return roe/refresh_search(actor, session)
end

verb roe/redraw(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  emit(session, {:kind -> :host_action, :action -> :redraw})
  return :ok
end
