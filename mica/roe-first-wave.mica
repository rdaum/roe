verb roe/publish_policy(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  // The host applies this emission as an atomic snapshot boundary. This makes
  // unit replacement retract removed settings instead of leaving stale Rust
  // projections behind.
  emit(session, {:kind -> :policy_reset})
  for found in roe/LogicalBuffer(?buffer)
    let mode_rows = roe/EffectiveMajorMode(found[:buffer], ?mode)
    if mode_rows
      let exactly {:mode -> mode} = mode_rows
      let name_rows = roe/ModeName(mode, ?name)
      if name_rows
        let exactly {:name -> name} = name_rows
        emit(session, {:kind -> :mode_policy, :buffer -> found[:buffer], :name -> name})
      end
    end
    for syntax in roe/EffectiveSyntaxRule(found[:buffer], ?mode, ?syntax_kind, ?pattern, ?precedence)
      emit(session, {:kind -> :syntax_policy, :buffer -> found[:buffer], :syntax_kind -> syntax[:syntax_kind], :pattern -> syntax[:pattern], :precedence -> syntax[:precedence]})
    end
  end
  for found in roe/Face(?face)
    let name_rows = roe/FaceName(found[:face], ?name)
    if name_rows
      let exactly {:name -> name} = name_rows
      for attribute in roe/EffectiveFaceAttribute(found[:face], ?attribute, ?value)
        emit(session, {:kind -> :face_policy, :face -> name, :attribute -> attribute[:attribute], :value -> attribute[:value]})
      end
    end
  end
  for setting in roe/EffectiveConfiguration(#roe/core_configuration, ?key, ?value)
    emit(session, {:kind -> :configuration_policy, :key -> setting[:key], :value -> setting[:value]})
  end
  return :ok
end

