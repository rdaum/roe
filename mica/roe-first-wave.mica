verb roe/execute_command(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  let target = one roe/ActiveView(session, ?view)
  assert roe/PromptState(session, :command, "", 0, target, nothing)
  return roe/refresh_prompt(actor, session)
end

verb roe/list_length(items)
  let count = 0
  for item in items
    count = count + 1
  end
  return count
end

verb roe/prompt_candidates(actor, session, prompt_kind, query)
  let candidates = []
  if prompt_kind == :command
    for found in roe/DiscoverableCommand(actor, ?command)
      let name = one roe/CommandName(found[:command], ?name)
      let selector = one roe/CommandSelector(found[:command], ?selector)
      if name != nothing && selector != nothing && (query == "" || string_contains(lower(name), lower(query))) && roe/list_length(candidates) < 256
        candidates = [@candidates, [name, selector]]
      end
    end
  elseif prompt_kind == :switch_buffer || prompt_kind == :kill_buffer
    for found in roe/LogicalBuffer(?buffer)
      if roe/CanUseBuffer(actor, found[:buffer])
        let name = one roe/BufferName(found[:buffer], ?name)
        if name != nothing && (query == "" || string_contains(lower(name), lower(query))) && roe/list_length(candidates) < 256
          candidates = [@candidates, [name, found[:buffer]]]
        end
      end
    end
  elseif prompt_kind == :find_file || prompt_kind == :visit_file
    for found in roe/FileCandidate(session, ?path, ?is_dir)
      if query == "" || string_contains(lower(found[:path]), lower(query))
        if roe/list_length(candidates) < 256
          candidates = [@candidates, [found[:path], found[:path]]]
        end
      end
    end
  elseif prompt_kind == :command_argument
    let state = one roe/PromptState(session, ?kind, ?state_query, ?selected, ?target, ?command)
    if state != nothing
      let completion = one roe/ArgumentCompletion(state[:command], 0, ?selector)
      for found in roe/ArgumentCandidate(completion, actor, session, ?candidate, ?label)
        if query == "" || string_contains(lower(found[:label]), lower(query))
          if roe/list_length(candidates) < 256
            candidates = [@candidates, [found[:label], found[:candidate]]]
          end
        end
      end
    end
  end
  return sort(candidates)
end

verb roe/refresh_prompt(actor, session)
  let state = one roe/PromptState(session, ?prompt_kind, ?query, ?selected, ?target, ?aux)
  state != nothing || return :no_prompt
  let candidates = roe/prompt_candidates(actor, session, state[:prompt_kind], state[:query])
  let selected = state[:selected]
  if roe/list_length(candidates) == 0
    selected = 0
  elseif selected >= roe/list_length(candidates)
    selected = roe/list_length(candidates) - 1
  end
  if selected != state[:selected]
    retract roe/PromptState(session, state[:prompt_kind], state[:query], state[:selected], state[:target], state[:aux])
    assert roe/PromptState(session, state[:prompt_kind], state[:query], selected, state[:target], state[:aux])
  end
  emit(session, {:kind -> :prompt_update, :prompt_kind -> state[:prompt_kind], :query -> state[:query], :selected -> selected, :candidates -> candidates})
  return :ok
end

verb roe/prompt_key(actor, session, sequence)
  let state = one roe/PromptState(session, ?prompt_kind, ?query, ?selected, ?target, ?aux)
  state != nothing || return :no_prompt
  if state[:prompt_kind] == :isearch_forward || state[:prompt_kind] == :isearch_backward
    return roe/search_prompt_key(actor, session, sequence)
  end
  let query = state[:query]
  let selected = state[:selected]
  let candidates = roe/prompt_candidates(actor, session, state[:prompt_kind], query)
  if sequence == "Esc" || sequence == "C-g"
    retract roe/PromptState(session, state[:prompt_kind], state[:query], state[:selected], state[:target], state[:aux])
    emit(session, {:kind -> :prompt_close})
    return :cancelled
  elseif sequence == "⌫"
    if string_len(query) > 0
      query = string_slice(query, 0, string_len(query) - 1)
    end
    selected = 0
  elseif sequence == "↑" || sequence == "C-p"
    if selected > 0
      selected = selected - 1
    end
  elseif sequence == "↓" || sequence == "C-n"
    if selected + 1 < roe/list_length(candidates)
      selected = selected + 1
    end
  elseif sequence == "⏎"
    if roe/list_length(candidates) == 0
      return roe/refresh_prompt(actor, session)
    end
    let chosen = candidates[selected]
    retract roe/PromptState(session, state[:prompt_kind], state[:query], state[:selected], state[:target], state[:aux])
    emit(session, {:kind -> :prompt_close})
    if state[:target] != nothing
      let current = one roe/ActiveView(session, ?view)
      if current != nothing && current != state[:target]
        retract roe/ActiveView(session, current)
        assert roe/ActiveView(session, state[:target])
      end
    end
    if state[:prompt_kind] == :command
      return invoke(chosen[1], {:actor -> actor, :session -> session})
    elseif state[:prompt_kind] == :switch_buffer
      emit(session, {:kind -> :host_action, :action -> :switch_buffer_selected, :buffer -> chosen[1]})
      return :ok
    elseif state[:prompt_kind] == :kill_buffer
      emit(session, {:kind -> :host_action, :action -> :kill_buffer_selected, :buffer -> chosen[1]})
      return :ok
    elseif state[:prompt_kind] == :find_file
      roe/CanRequestService(actor, :file_read) || return :file_read_denied
      emit(session, {:kind -> :host_action, :action -> :find_file_selected, :path -> chosen[1]})
      return :ok
    elseif state[:prompt_kind] == :visit_file
      roe/CanRequestService(actor, :file_read) || return :file_read_denied
      emit(session, {:kind -> :host_action, :action -> :visit_file_selected, :path -> chosen[1]})
      return :ok
    elseif state[:prompt_kind] == :command_argument
      let accepted = invoke(:roe/accept_argument_candidate, {:actor -> actor, :session -> session, :command -> state[:aux], :position -> 0, :candidate -> chosen[1]})
      accepted[:kind] == :argument_value || return :invalid_argument
      let implementation = one roe/CommandImplementation(state[:aux], ?selector)
      implementation != nothing || return :missing_implementation
      return invoke(implementation, {:actor -> actor, :session -> session, :value -> accepted[:value]})
    end
  elseif string_len(sequence) == 1
    query = string_concat(query, sequence)
    selected = 0
  else
    return :handled
  end
  retract roe/PromptState(session, state[:prompt_kind], state[:query], state[:selected], state[:target], state[:aux])
  assert roe/PromptState(session, state[:prompt_kind], query, selected, state[:target], state[:aux])
  return roe/refresh_prompt(actor, session)
end

verb roe/isearch_forward(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  return roe/start_search(actor, session, :isearch_forward)
end

verb roe/isearch_backward(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  return roe/start_search(actor, session, :isearch_backward)
end

verb roe/start_search(actor, session, prompt_kind)
  roe/CanRequestService(actor, :text_read) || return :text_read_denied
  let target = one roe/ActiveView(session, ?view)
  let original = one roe/ViewCursor(target, ?cursor)
  let previous = one roe/PromptLast(session, :search, ?query)
  if previous == nothing
    previous = ""
  end
  assert roe/PromptState(session, prompt_kind, previous, 0, target, original)
  return roe/refresh_search(actor, session)
end

verb roe/refresh_search(actor, session)
  let state = one roe/PromptState(session, ?prompt_kind, ?query, ?selected, ?target, ?aux)
  state != nothing || return :no_prompt
  let buffer = one roe/ViewBuffer(state[:target], ?buffer)
  buffer != nothing || return :no_buffer
  let result = external_request(:text_search, {:buffer -> buffer, :query -> state[:query]}, 1)
  if result[:status] != :ok
    raise E_NATIVE, result[:error]
  end
  let matches = result[:value]
  let selected = state[:selected]
  let count = roe/list_length(matches)
  if count == 0
    selected = 0
  elseif selected >= count
    selected = count - 1
  end
  if selected != state[:selected]
    retract roe/PromptState(session, state[:prompt_kind], state[:query], state[:selected], state[:target], state[:aux])
    assert roe/PromptState(session, state[:prompt_kind], state[:query], selected, state[:target], state[:aux])
  end
  emit(session, {:kind -> :prompt_update, :prompt_kind -> state[:prompt_kind], :query -> state[:query], :selected -> selected, :candidates -> []})
  emit(session, {:kind -> :search_update, :view -> state[:target], :matches -> matches, :selected -> selected})
  return :ok
end

verb roe/search_prompt_key(actor, session, sequence)
  let state = one roe/PromptState(session, ?prompt_kind, ?query, ?selected, ?target, ?aux)
  state != nothing || return :no_prompt
  let query = state[:query]
  let selected = state[:selected]
  if sequence == "Esc" || sequence == "C-g"
    retract roe/PromptState(session, state[:prompt_kind], state[:query], state[:selected], state[:target], state[:aux])
    emit(session, {:kind -> :search_finish, :view -> state[:target], :original -> state[:aux], :query -> state[:query], :accepted -> false})
    emit(session, {:kind -> :prompt_close})
    return :cancelled
  elseif sequence == "⏎"
    let previous = one roe/PromptLast(session, :search, ?previous)
    if previous != nothing
      retract roe/PromptLast(session, :search, previous)
    end
    assert roe/PromptLast(session, :search, state[:query])
    retract roe/PromptState(session, state[:prompt_kind], state[:query], state[:selected], state[:target], state[:aux])
    emit(session, {:kind -> :search_finish, :view -> state[:target], :original -> state[:aux], :query -> state[:query], :accepted -> true})
    emit(session, {:kind -> :prompt_close})
    return :accepted
  elseif sequence == "⌫"
    if string_len(query) > 0
      query = string_slice(query, 0, string_len(query) - 1)
    end
    selected = 0
  elseif sequence == "C-s" || sequence == "↓"
    selected = selected + 1
  elseif sequence == "C-r" || sequence == "↑"
    if selected > 0
      selected = selected - 1
    end
  elseif string_len(sequence) == 1
    query = string_concat(query, sequence)
    selected = 0
  else
    return :handled
  end
  retract roe/PromptState(session, state[:prompt_kind], state[:query], state[:selected], state[:target], state[:aux])
  assert roe/PromptState(session, state[:prompt_kind], query, selected, state[:target], state[:aux])
  return roe/refresh_search(actor, session)
end

verb roe/redraw(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  emit(session, {:kind -> :host_action, :action -> :redraw})
  return :ok
end
