verb roe/other_window(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  let current_rows = roe/ActiveView(session, ?view)
  if not current_rows
    return :no_active_view
  end
  let exactly {:view -> current} = current_rows
  let next_rows = roe/NextView(current, ?view)
  if not next_rows
    return :no_next_view
  end
  let exactly {:view -> next} = next_rows
  roe/SessionLeafView(session, next) || return :invalid_next_view
  retract roe/ActiveView(session, current)
  assert roe/ActiveView(session, next)
  emit(session, {:kind -> :presentation_invalidated, :view -> next})
  return next
end

verb roe/dispatch_key(actor, session, sequence @ #string)
  roe/publish_policy(actor, session)
  let native_action = none
  let native_precedence = -2147483648
  let native_ambiguous = false
  for native in roe/NativeBinding(sequence, ?action, ?precedence)
    if not native_action || native[:precedence] > native_precedence
      native_action = some(native[:action])
      native_precedence = native[:precedence]
      native_ambiguous = false
    elseif native[:precedence] == native_precedence
      let exactly {:value -> current_native_action} = native_action
      if current_native_action != native[:action]
        native_ambiguous = true
      end
    end
  end
  let selected = none
  let selected_precedence = -2147483648
  let command_ambiguous = false
  for active in roe/EffectiveSessionKeymap(session, ?keymap, ?session_precedence)
    for binding in roe/EffectiveBinding(active[:keymap], sequence, ?command, ?precedence)
      let precedence = active[:session_precedence] + binding[:precedence]
      if not selected || precedence > selected_precedence
        selected = some(binding[:command])
        selected_precedence = precedence
        command_ambiguous = false
      elseif precedence == selected_precedence
        let exactly {:value -> current_command} = selected
        if current_command != binding[:command]
          command_ambiguous = true
        end
      end
    end
  end
  if native_action && (not selected || native_precedence > selected_precedence)
    if native_ambiguous
      raise E_AMBIGUOUS, "ambiguous native key binding"
    end
    let exactly {:value -> action} = native_action
    return roe/run_native_action(actor, session, action)
  end
  if native_action && selected && native_precedence == selected_precedence
    raise E_AMBIGUOUS, "native and command bindings have equal precedence"
  end
  if not selected
    if roe/KeyPrefix(sequence)
      return :prefix
    end
    if string_len(sequence) == 1
      roe/CanRequestService(actor, :text_write) || return :text_write_denied
      emit(session, {:kind -> :native_action, :action -> :insert_text, :text -> sequence})
      roe/emit_edit_hooks(actor, session)
      return :handled
    end
    return :unbound
  end
  if command_ambiguous
    raise E_AMBIGUOUS, "ambiguous command key binding"
  end
  let exactly {:value -> selected_command} = selected
  let selector_rows = roe/CommandSelector(selected_command, ?selector)
  if not selector_rows
    raise E_COMMAND, "selected command has no selector"
  end
  let exactly {:selector -> selector} = selector_rows
  return invoke(selector, {:actor -> actor, :session -> session})
end

verb roe/run_native_action(actor, session, action)
  if roe/NativeEditingAction(action)
    roe/CanRequestService(actor, :text_write) || return :text_write_denied
    let exactly {:view -> view} = roe/ActiveView(session, ?view)
    let exactly {:buffer -> buffer} = roe/ViewBuffer(view, ?buffer)
    roe/CanUseBuffer(actor, buffer) || return :buffer_denied
  end
  if roe/NativeBufferReadAction(action)
    roe/CanRequestService(actor, :text_read) || return :text_read_denied
    let exactly {:view -> read_view} = roe/ActiveView(session, ?view)
    let exactly {:buffer -> read_buffer} = roe/ViewBuffer(read_view, ?buffer)
    roe/CanUseBuffer(actor, read_buffer) || return :buffer_denied
  end
  if action == :kill_line || action == :kill_region || action == :copy_region || action == :kill_word || action == :backward_kill_word
    roe/CanRequestService(actor, :clipboard_write) || return :clipboard_write_denied
  end
  if action == :yank
    roe/CanRequestService(actor, :clipboard_read) || return :clipboard_read_denied
  end
  if action == :indent
    let width = 4
    let width_rows = roe/EffectiveConfiguration(#roe/core_configuration, :tab_width, ?width)
    if width_rows
      let exactly {:width -> configured_width} = width_rows
      width = configured_width
    end
    let text = ""
    let count = 0
    while count < width
      text = string_concat(text, " ")
      count = count + 1
    end
    emit(session, {:kind -> :native_action, :action -> :insert_text, :text -> text})
  else
    emit(session, {:kind -> :native_action, :action -> action})
  end
  if roe/NativeEditingAction(action)
    roe/emit_edit_hooks(actor, session)
  end
  return :handled
end

verb roe/emit_edit_hooks(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  let exactly {:view -> view} = roe/ActiveView(session, ?view)
  let exactly {:buffer -> buffer} = roe/ViewBuffer(view, ?buffer)
  let hooks = []
  for hook in roe/EffectiveModeHook(buffer, ?hook, ?precedence)
    hooks = [@hooks, [0 - hook[:precedence], hook[:hook]]]
  end
  for hook in sort(hooks)
    invoke(hook[1], {:actor -> actor, :session -> session, :view -> view, :buffer -> buffer})
  end
  return :ok
end

verb roe/invalidate_syntax_hook(actor, session, view, buffer)
  roe/SessionActor(session, actor) || return :not_session_actor
  emit(session, {:kind -> :host_action, :action -> :invalidate_syntax, :view -> view, :buffer -> buffer})
  return :ok
end

verb roe/pointer_event(actor, session, view, position, phase, button)
  roe/SessionActor(session, actor) || return :not_session_actor
  roe/SessionLeafView(session, view) || return :invalid_view
  let exactly {:buffer -> buffer} = roe/ViewBuffer(view, ?buffer)
  roe/CanUseBuffer(actor, buffer) || return :buffer_denied
  if button != :primary && phase != :move && phase != :up
    return :ignored
  end

  if phase == :layout_down
    roe/CanRequestService(actor, :layout_validate) || return :layout_denied
    emit(session, {:kind -> :host_action, :action -> :begin_layout_drag, :view -> view})
    return :handled
  end

  let pointer_rows = roe/PointerSelection(session, ?view, ?anchor)
  if phase == :up
    if pointer_rows
      let exactly {:view -> pointer_view, :anchor -> pointer_anchor} = pointer_rows
      retract roe/PointerSelection(session, pointer_view, pointer_anchor)
    end
    emit(session, {:kind -> :host_action, :action -> :pointer_selection, :view -> view, :position -> position, :phase -> phase})
    return :handled
  end

  if phase == :down
    if pointer_rows
      let exactly {:view -> pointer_view, :anchor -> pointer_anchor} = pointer_rows
      retract roe/PointerSelection(session, pointer_view, pointer_anchor)
    end
    let active_rows = roe/ActiveView(session, ?active)
    if active_rows
      let exactly {:active -> active} = active_rows
      if active != view
        retract roe/ActiveView(session, active)
      end
    end
    assert roe/ActiveView(session, view)
    assert roe/PointerSelection(session, view, position)
    emit(session, {:kind -> :host_action, :action -> :pointer_selection, :view -> view, :position -> position, :anchor -> position, :phase -> phase})
    return :handled
  end

  if phase == :move
    pointer_rows || return :no_pointer_selection
    let exactly {:view -> pointer_view, :anchor -> pointer_anchor} = pointer_rows
    pointer_view == view || return :pointer_view_mismatch
    emit(session, {:kind -> :host_action, :action -> :pointer_selection, :view -> view, :position -> position, :anchor -> pointer_anchor, :phase -> phase})
    return :handled
  end
  return :ignored
end

verb roe/set_view_scroll(actor, session, view, line, column)
  roe/SessionActor(session, actor) || return :not_session_actor
  roe/SessionLeafView(session, view) || return :invalid_view
  emit(session, {:kind -> :host_action, :action -> :set_view_scroll, :view -> view, :line -> line, :column -> column})
  return :handled
end

verb roe/set_split_ratio(actor, session, node, ratio)
  roe/SessionActor(session, actor) || return :not_session_actor
  roe/CanRequestService(actor, :layout_validate) || return :layout_denied
  let old_rows = roe/ViewSplitRatio(node, ?old_ratio)
  old_rows || return :invalid_split
  let exactly {:old_ratio -> old} = old_rows
  ratio > 0.0 && ratio < 1.0 || return :invalid_ratio
  retract roe/ViewSplitRatio(node, old)
  assert roe/ViewSplitRatio(node, ratio)
  emit(session, {:kind -> :host_action, :action -> :set_split_ratio, :node -> node, :ratio -> ratio})
  return :handled
end

// Return either a supplied value or the declarative prompt/completion request
// that a Mica-owned minibuffer will realize in Phase 5.
verb roe/acquire_argument(actor, session, command, position, supplied: option<dynamic>)
  roe/SessionActor(session, actor) || return :not_session_actor
  roe/DiscoverableCommand(actor, command) || return :not_discoverable
  if supplied
    let exactly {:value -> supplied_value} = supplied
    return {:kind -> :argument_value, :value -> supplied_value}
  end
  let argument_rows = roe/CommandArgument(command, position, ?name, ?value_kind)
  if not argument_rows
    return :missing_argument
  end
  let exactly {:name -> name, :value_kind -> value_kind} = argument_rows
  let prompt_rows = roe/ArgumentPrompt(command, position, ?prompt)
  if not prompt_rows
    return :missing_prompt
  end
  let exactly {:prompt -> prompt} = prompt_rows
  let completion = none
  let completion_rows = roe/ArgumentCompletion(command, position, ?selector)
  if completion_rows
    let exactly {:selector -> selector} = completion_rows
    let exactly {:value_kind -> candidate_kind} = roe/ArgumentCandidateKind(selector, ?value_kind)
    candidate_kind == value_kind || return :invalid_completion_type
    completion = some(selector)
  end
  return {:kind -> :argument_required, :name -> name, :value_kind -> value_kind, :prompt -> prompt, :completion -> completion}
end

// Validate a completion against the command's declared provider rather than
// accepting an arbitrary UI-supplied logical identity.
verb roe/accept_argument_candidate(actor, session, command, position, candidate)
  roe/SessionActor(session, actor) || return :not_session_actor
  roe/DiscoverableCommand(actor, command) || return :not_discoverable
  let completion_rows = roe/ArgumentCompletion(command, position, ?selector)
  if not completion_rows
    return :missing_completion
  end
  let exactly {:selector -> completion} = completion_rows
  let selected_rows = roe/ArgumentCandidate(completion, actor, session, candidate, ?label)
  if not selected_rows
    return :invalid_candidate
  end
  let exactly {:label -> selected_label} = selected_rows
  let argument_rows = roe/CommandArgument(command, position, ?name, ?value_kind)
  argument_rows || return :missing_argument
  let exactly {:name -> argument_name, :value_kind -> argument_kind} = argument_rows
  let candidate_kind_rows = roe/ArgumentCandidateKind(completion, ?value_kind)
  candidate_kind_rows || return :invalid_candidate_type
  let exactly {:value_kind -> candidate_kind} = candidate_kind_rows
  candidate_kind == argument_kind || return :invalid_candidate_type
  if argument_kind == :logical_view
    roe/SessionLeafView(session, candidate) || return :invalid_candidate_type
  elseif argument_kind == :logical_buffer
    roe/VisibleBuffer(session, candidate) || return :invalid_candidate_type
  elseif argument_kind == :selector
    CanInvoke(actor, candidate) || return :invalid_candidate_type
  elseif argument_kind != :path && argument_kind != :opaque
    return :unsupported_candidate_type
  end
  return {:kind -> :argument_value, :value -> candidate, :label -> selected_label, :value_kind -> argument_kind}
end
