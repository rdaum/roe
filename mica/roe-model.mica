assert RoleCanRead(#roe/editor_role, :roe/EffectiveModeHook)
assert RoleCanRead(#roe/editor_role, :roe/EffectiveMajorMode)
assert RoleCanRead(#roe/editor_role, :roe/ModeName)
assert RoleCanRead(#roe/editor_role, :roe/FaceName)
