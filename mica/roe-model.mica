verb roe/other_window(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  let current = one roe/ActiveView(session, ?view)
  if current == nothing
    return :no_active_view
  end
  let next = one roe/NextView(current, ?view)
  if next == nothing
    return :no_next_view
  end
  roe/SessionLeafView(session, next) || return :invalid_next_view
  retract roe/ActiveView(session, current)
  assert roe/ActiveView(session, next)
  emit(session, {:kind -> :presentation_invalidated, :view -> next})
  return next
end

verb roe/dispatch_key(actor, session, sequence @ #string)
  roe/publish_policy(actor, session)
  let native_action = nothing
  let native_precedence = -2147483648
  let native_ambiguous = false
  for native in roe/NativeBinding(sequence, ?action, ?precedence)
    if native_action == nothing || native[:precedence] > native_precedence
      native_action = native[:action]
      native_precedence = native[:precedence]
      native_ambiguous = false
    elseif native[:precedence] == native_precedence && native_action != native[:action]
      native_ambiguous = true
    end
  end
  let selected = nothing
  let selected_precedence = -2147483648
  let command_ambiguous = false
  for active in roe/EffectiveSessionKeymap(session, ?keymap, ?session_precedence)
    for binding in roe/EffectiveBinding(active[:keymap], sequence, ?command, ?precedence)
      let precedence = active[:session_precedence] + binding[:precedence]
      if selected == nothing || precedence > selected_precedence
        selected = binding[:command]
        selected_precedence = precedence
        command_ambiguous = false
      elseif precedence == selected_precedence && selected != binding[:command]
        command_ambiguous = true
      end
    end
  end
  if native_action != nothing && (selected == nothing || native_precedence > selected_precedence)
    if native_ambiguous
      raise E_AMBIGUOUS, "ambiguous native key binding"
    end
    return roe/run_native_action(actor, session, native_action)
  end
  if native_action != nothing && selected != nothing && native_precedence == selected_precedence
    raise E_AMBIGUOUS, "native and command bindings have equal precedence"
  end
  if selected == nothing
    if roe/KeyPrefix(sequence)
      return :prefix
    end
    if string_len(sequence) == 1
      roe/CanRequestService(actor, :text_write) || return :text_write_denied
      emit(session, {:kind -> :native_action, :action -> :insert_text, :text -> sequence})
      roe/emit_edit_hooks(actor, session)
      return :handled
    end
    return :unbound
  end
  if command_ambiguous
    raise E_AMBIGUOUS, "ambiguous command key binding"
  end
  let selector = one roe/CommandSelector(selected, ?selector)
  if selector == nothing
    raise E_COMMAND, "selected command has no selector"
  end
  return invoke(selector, {:actor -> actor, :session -> session})
end

verb roe/run_native_action(actor, session, action)
  if roe/NativeEditingAction(action)
    roe/CanRequestService(actor, :text_write) || return :text_write_denied
    let view = one roe/ActiveView(session, ?view)
    let buffer = one roe/ViewBuffer(view, ?buffer)
    roe/CanUseBuffer(actor, buffer) || return :buffer_denied
  end
  if roe/NativeBufferReadAction(action)
    roe/CanRequestService(actor, :text_read) || return :text_read_denied
    let read_view = one roe/ActiveView(session, ?view)
    let read_buffer = one roe/ViewBuffer(read_view, ?buffer)
    roe/CanUseBuffer(actor, read_buffer) || return :buffer_denied
  end
  if action == :kill_line || action == :kill_region || action == :copy_region || action == :kill_word || action == :backward_kill_word
    roe/CanRequestService(actor, :clipboard_write) || return :clipboard_write_denied
  end
  if action == :yank
    roe/CanRequestService(actor, :clipboard_read) || return :clipboard_read_denied
  end
  if action == :indent
    let width = one roe/EffectiveConfiguration(#roe/core_configuration, :tab_width, ?width)
    if width == nothing
      width = 4
    end
    let text = ""
    let count = 0
    while count < width
      text = string_concat(text, " ")
      count = count + 1
    end
    emit(session, {:kind -> :native_action, :action -> :insert_text, :text -> text})
  else
    emit(session, {:kind -> :native_action, :action -> action})
  end
  if roe/NativeEditingAction(action)
    roe/emit_edit_hooks(actor, session)
  end
  return :handled
end

verb roe/emit_edit_hooks(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  let view = one roe/ActiveView(session, ?view)
  let buffer = one roe/ViewBuffer(view, ?buffer)
  let hooks = []
  for hook in roe/EffectiveModeHook(buffer, ?hook, ?precedence)
    hooks = [@hooks, [0 - hook[:precedence], hook[:hook]]]
  end
  for hook in sort(hooks)
    invoke(hook[1], {:actor -> actor, :session -> session, :view -> view, :buffer -> buffer})
  end
  return :ok
end

verb roe/invalidate_syntax_hook(actor, session, view, buffer)
  roe/SessionActor(session, actor) || return :not_session_actor
  emit(session, {:kind -> :host_action, :action -> :invalidate_syntax, :view -> view, :buffer -> buffer})
  return :ok
end

verb roe/pointer_event(actor, session, view, position, phase, button)
  roe/SessionActor(session, actor) || return :not_session_actor
  roe/SessionLeafView(session, view) || return :invalid_view
  let buffer = one roe/ViewBuffer(view, ?buffer)
  roe/CanUseBuffer(actor, buffer) || return :buffer_denied
  if button != :primary && phase != :move && phase != :up
    return :ignored
  end

  if phase == :layout_down
    roe/CanRequestService(actor, :layout_validate) || return :layout_denied
    emit(session, {:kind -> :host_action, :action -> :begin_layout_drag, :view -> view})
    return :handled
  end

  let pointer = one roe/PointerSelection(session, ?view, ?anchor)
  if phase == :up
    if pointer != nothing
      retract roe/PointerSelection(session, pointer[:view], pointer[:anchor])
    end
    emit(session, {:kind -> :host_action, :action -> :pointer_selection, :view -> view, :position -> position, :phase -> phase})
    return :handled
  end

  if phase == :down
    if pointer != nothing
      retract roe/PointerSelection(session, pointer[:view], pointer[:anchor])
    end
    let active = one roe/ActiveView(session, ?active)
    if active != nothing && active != view
      retract roe/ActiveView(session, active)
    end
    assert roe/ActiveView(session, view)
    let old_cursor = one roe/ViewCursor(view, ?cursor)
    if old_cursor != nothing
      retract roe/ViewCursor(view, old_cursor)
    end
    let old_mark = one roe/ViewMark(view, ?mark)
    if old_mark != nothing
      retract roe/ViewMark(view, old_mark)
    end
    for old_selection in roe/ViewSelection(view, ?anchor, ?active)
      retract roe/ViewSelection(view, old_selection[:anchor], old_selection[:active])
    end
    assert roe/ViewCursor(view, position)
    assert roe/PointerSelection(session, view, position)
    emit(session, {:kind -> :host_action, :action -> :pointer_selection, :view -> view, :position -> position, :anchor -> position, :phase -> phase})
    return :handled
  end

  if phase == :move
    pointer != nothing || return :no_pointer_selection
    pointer[:view] == view || return :pointer_view_mismatch
    let old_cursor = one roe/ViewCursor(view, ?cursor)
    if old_cursor != nothing
      retract roe/ViewCursor(view, old_cursor)
    end
    let old_mark = one roe/ViewMark(view, ?mark)
    if old_mark != nothing
      retract roe/ViewMark(view, old_mark)
    end
    for old_selection in roe/ViewSelection(view, ?anchor, ?active)
      retract roe/ViewSelection(view, old_selection[:anchor], old_selection[:active])
    end
    assert roe/ViewCursor(view, position)
    assert roe/ViewMark(view, pointer[:anchor])
    assert roe/ViewSelection(view, pointer[:anchor], position)
    emit(session, {:kind -> :host_action, :action -> :pointer_selection, :view -> view, :position -> position, :anchor -> pointer[:anchor], :phase -> phase})
    return :handled
  end
  return :ignored
end

verb roe/set_view_scroll(actor, session, view, line, column)
  roe/SessionActor(session, actor) || return :not_session_actor
  roe/SessionLeafView(session, view) || return :invalid_view
  emit(session, {:kind -> :host_action, :action -> :set_view_scroll, :view -> view, :line -> line, :column -> column})
  return :handled
end

verb roe/set_split_ratio(actor, session, node, ratio)
  roe/SessionActor(session, actor) || return :not_session_actor
  roe/CanRequestService(actor, :layout_validate) || return :layout_denied
  let old = one roe/ViewSplitRatio(node, ?ratio)
  old != nothing || return :invalid_split
  ratio > 0.0 && ratio < 1.0 || return :invalid_ratio
  retract roe/ViewSplitRatio(node, old)
  assert roe/ViewSplitRatio(node, ratio)
  emit(session, {:kind -> :host_action, :action -> :set_split_ratio, :node -> node, :ratio -> ratio})
  return :handled
end

// Return either a supplied value or the declarative prompt/completion request
// that a Mica-owned minibuffer will realize in Phase 5.
verb roe/acquire_argument(actor, session, command, position, supplied)
  roe/SessionActor(session, actor) || return :not_session_actor
  roe/DiscoverableCommand(actor, command) || return :not_discoverable
  if supplied != nothing
    return {:kind -> :argument_value, :value -> supplied}
  end
  let argument = one roe/CommandArgument(command, position, ?name, ?value_kind)
  if argument == nothing
    return :missing_argument
  end
  let prompt = one roe/ArgumentPrompt(command, position, ?prompt)
  if prompt == nothing
    return :missing_prompt
  end
  let completion = one roe/ArgumentCompletion(command, position, ?selector)
  let candidate_kind = one roe/ArgumentCandidateKind(completion, ?value_kind)
  if completion != nothing && candidate_kind != argument[:value_kind]
    return :invalid_completion_type
  end
  return {:kind -> :argument_required, :name -> argument[:name], :value_kind -> argument[:value_kind], :prompt -> prompt, :completion -> completion}
end

// Validate a completion against the command's declared provider rather than
// accepting an arbitrary UI-supplied logical identity.
verb roe/accept_argument_candidate(actor, session, command, position, candidate)
  roe/SessionActor(session, actor) || return :not_session_actor
  roe/DiscoverableCommand(actor, command) || return :not_discoverable
  let completion = one roe/ArgumentCompletion(command, position, ?selector)
  if completion == nothing
    return :missing_completion
  end
  let selected = one roe/ArgumentCandidate(completion, actor, session, candidate, ?label)
  if selected == nothing
    return :invalid_candidate
  end
  let argument = one roe/CommandArgument(command, position, ?name, ?value_kind)
  argument != nothing || return :missing_argument
  let candidate_kind = one roe/ArgumentCandidateKind(completion, ?value_kind)
  candidate_kind != nothing || return :invalid_candidate_type
  candidate_kind == argument[:value_kind] || return :invalid_candidate_type
  if argument[:value_kind] == :logical_view
    roe/SessionLeafView(session, candidate) || return :invalid_candidate_type
  elseif argument[:value_kind] == :logical_buffer
    roe/VisibleBuffer(session, candidate) || return :invalid_candidate_type
  elseif argument[:value_kind] == :selector
    CanInvoke(actor, candidate) || return :invalid_candidate_type
  elseif argument[:value_kind] != :path && argument[:value_kind] != :opaque
    return :unsupported_candidate_type
  end
  return {:kind -> :argument_value, :value -> candidate, :label -> selected, :value_kind -> argument[:value_kind]}
end
