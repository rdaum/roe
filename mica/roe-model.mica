// Roe's Phase 3 Mica object-model prototype.
//
// This unit deliberately contains editor policy and logical identities only.
// Native ResourceId values and endpoint capabilities are asserted as volatile
// tuples by the host and are never part of this filein unit.

make_identity(:roe/editor_actor)
make_identity(:roe/editor_session)
make_identity(:roe/frame)
make_identity(:roe/view)
make_identity(:roe/buffer)
make_identity(:roe/command)
make_identity(:roe/keymap)
make_identity(:roe/mode)
make_identity(:roe/hook)
make_identity(:roe/face)
make_identity(:roe/syntax_rule)
make_identity(:roe/package)

make_identity(:roe/global_map)
make_identity(:roe/other_window)
make_identity(:roe/fundamental_mode)
make_identity(:roe/default_face)
make_identity(:roe/core_package)
make_identity(:roe/editor_role)
make_identity(:roe/core_configuration)

make_relation(:Delegates, 3)

// Durable programmable description. These facts may be filed out as a named
// unit; they contain no host capability or process identity.
make_relation(:roe/Command, 1)
make_functional_relation(:roe/CommandSelector, 2, [0])
make_functional_relation(:roe/CommandSummary, 2, [0])
make_functional_relation(:roe/CommandName, 2, [0])
make_functional_relation(:roe/CommandHostAction, 2, [0])
make_relation(:roe/CommandArgument, 4)
make_relation(:roe/ArgumentPrompt, 3)
make_relation(:roe/ArgumentCompletion, 3)
make_relation(:roe/ArgumentCandidate, 5)
make_relation(:roe/Keymap, 1)
make_relation(:roe/KeymapParent, 2)
make_relation(:roe/KeyBinding, 4)
make_relation(:roe/KeyPrefix, 1)
make_relation(:roe/NativeBinding, 3)
make_relation(:roe/NativeEditingAction, 1)
make_relation(:roe/MajorMode, 1)
make_relation(:roe/MinorMode, 1)
make_functional_relation(:roe/ModeName, 2, [0])
make_relation(:roe/ModeKeymap, 3)
make_relation(:roe/ModeHook, 3)
make_relation(:roe/Face, 1)
make_functional_relation(:roe/FaceName, 2, [0])
make_relation(:roe/FaceParent, 2)
make_relation(:roe/FaceAttribute, 3)
make_relation(:roe/SyntaxRule, 4)
make_relation(:roe/Configuration, 3)
make_relation(:roe/ConfigurationParent, 2)
make_relation(:roe/Package, 1)
make_functional_relation(:roe/PackageUnit, 2, [0])
make_functional_relation(:roe/PackageEnabled, 2, [0])
make_relation(:roe/PackageDisabled, 1, :volatile)
make_relation(:roe/PackageCommand, 2)
make_relation(:roe/PackageKeymap, 2)
make_relation(:roe/PackageMode, 2)

// Session-volatile logical state. Phase 4 asserts and retracts these tuples at
// endpoint open/close using the public mica-driver volatile-tuple API.
make_relation(:roe/EditorSession, 1, :volatile)
make_functional_relation(:roe/SessionActor, 2, [0], :volatile)
make_functional_relation(:roe/SessionFrame, 2, [0], :volatile)
make_functional_relation(:roe/SessionEndpoint, 2, [0], :volatile)
make_relation(:roe/LogicalBuffer, 1, :volatile)
make_functional_relation(:roe/BufferName, 2, [0], :volatile)
make_functional_relation(:roe/BufferMajorMode, 2, [0], :volatile)
make_relation(:roe/BufferMinorMode, 2, :volatile)
make_relation(:roe/Frame, 1, :volatile)
make_functional_relation(:roe/FrameRootView, 2, [0], :volatile)
make_relation(:roe/View, 1, :volatile)
make_functional_relation(:roe/ViewBuffer, 2, [0], :volatile)
make_functional_relation(:roe/ViewParent, 2, [0], :volatile)
make_functional_relation(:roe/ViewFirstChild, 2, [0], :volatile)
make_functional_relation(:roe/ViewSecondChild, 2, [0], :volatile)
make_functional_relation(:roe/ViewSplitAxis, 2, [0], :volatile)
make_functional_relation(:roe/ViewSplitRatio, 2, [0], :volatile)
make_functional_relation(:roe/ActiveView, 2, [0], :volatile)
make_functional_relation(:roe/ViewCursor, 2, [0], :volatile)
make_functional_relation(:roe/ViewMark, 2, [0], :volatile)
make_relation(:roe/ViewSelection, 3, :volatile)
make_relation(:roe/SessionKeymap, 3, :volatile)
make_relation(:roe/NextView, 2, :volatile)
make_relation(:roe/ActorRole, 2, :volatile)
make_functional_relation(:roe/PromptState, 6, [0], :volatile)
make_functional_relation(:roe/PromptLast, 3, [0, 1], :volatile)
make_relation(:roe/FileCandidate, 3, :volatile)

// Ephemeral host associations and native-cached observations. The host owns
// their invalidation and never persists them in a named unit or durable store.
make_functional_relation(:roe/NativeTextResource, 2, [0], :volatile)
make_functional_relation(:roe/NativeResourceGeneration, 2, [0], :volatile)
make_functional_relation(:roe/NativeBufferRevision, 2, [0], :volatile)
make_functional_relation(:roe/PresentationRevision, 2, [0], :volatile)

// Durable roles describe authority. ActorRole and buffer grants are endpoint
// volatile; the effective Can* relations are derived before every invocation.
make_relation(:RoleCanRead, 2)
make_relation(:RoleCanWrite, 2)
make_relation(:RoleCanInvoke, 2)
make_relation(:RoleCanEffect, 1)
make_relation(:roe/RoleCanRequestService, 2)
make_relation(:CanRead, 2)
make_relation(:CanWrite, 2)
make_relation(:CanInvoke, 2)
make_relation(:CanEffect, 1)
make_relation(:roe/CanUseBuffer, 2, :volatile)
make_relation(:roe/CanRequestService, 2)

// Derived editor facts.
make_relation(:roe/EnabledCommand, 1)
make_relation(:roe/EnabledKeymap, 1)
make_relation(:roe/EnabledMode, 1)
make_relation(:roe/EffectiveBinding, 4)
make_relation(:roe/EffectiveSessionKeymap, 3)
make_relation(:roe/DiscoverableCommand, 2)
make_relation(:roe/ViewInTree, 2)
make_relation(:roe/SessionLeafView, 2)
make_relation(:roe/VisibleBuffer, 2)
make_relation(:roe/EffectiveMajorMode, 2)
make_relation(:roe/EffectiveModeHook, 3)
make_relation(:roe/LocalFaceAttribute, 2)
make_relation(:roe/EffectiveFaceAttribute, 3)
make_relation(:roe/EffectiveSyntaxRule, 5)
make_relation(:roe/LocalConfiguration, 2)
make_relation(:roe/EffectiveConfiguration, 3)

CanRead(actor, relation) :-
  roe/ActorRole(actor, role),
  RoleCanRead(role, relation)

CanWrite(actor, relation) :-
  roe/ActorRole(actor, role),
  RoleCanWrite(role, relation)

CanInvoke(actor, selector) :-
  roe/ActorRole(actor, role),
  RoleCanInvoke(role, selector)

CanEffect(actor) :-
  roe/ActorRole(actor, role),
  RoleCanEffect(role)

roe/CanRequestService(actor, service) :-
  roe/ActorRole(actor, role),
  roe/RoleCanRequestService(role, service)

roe/EnabledCommand(command) :-
  roe/PackageEnabled(package, true),
  not roe/PackageDisabled(package),
  roe/PackageCommand(package, command)

roe/EnabledKeymap(keymap) :-
  roe/PackageEnabled(package, true),
  not roe/PackageDisabled(package),
  roe/PackageKeymap(package, keymap)

roe/EnabledMode(mode) :-
  roe/PackageEnabled(package, true),
  not roe/PackageDisabled(package),
  roe/PackageMode(package, mode)

roe/EffectiveBinding(keymap, sequence, command, precedence) :-
  roe/EnabledKeymap(keymap),
  roe/EnabledCommand(command),
  roe/KeyBinding(keymap, sequence, command, precedence)

roe/EffectiveBinding(keymap, sequence, command, precedence) :-
  roe/EnabledKeymap(keymap),
  roe/KeymapParent(keymap, parent),
  roe/EffectiveBinding(parent, sequence, command, precedence)

roe/EffectiveSessionKeymap(session, keymap, precedence) :-
  roe/SessionKeymap(session, keymap, precedence),
  roe/EnabledKeymap(keymap)

roe/EffectiveSessionKeymap(session, keymap, precedence) :-
  roe/ActiveView(session, view),
  roe/ViewBuffer(view, buffer),
  roe/BufferMajorMode(buffer, mode),
  roe/EnabledMode(mode),
  roe/ModeKeymap(mode, keymap, precedence),
  roe/EnabledKeymap(keymap)

roe/EffectiveSessionKeymap(session, keymap, precedence) :-
  roe/ActiveView(session, view),
  roe/ViewBuffer(view, buffer),
  roe/BufferMinorMode(buffer, mode),
  roe/EnabledMode(mode),
  roe/ModeKeymap(mode, keymap, precedence),
  roe/EnabledKeymap(keymap)

roe/DiscoverableCommand(actor, command) :-
  roe/EnabledCommand(command),
  roe/Command(command),
  roe/CommandSelector(command, selector),
  CanInvoke(actor, selector)

roe/ViewInTree(root, root) :-
  roe/View(root)

roe/ViewInTree(root, view) :-
  roe/ViewFirstChild(root, child),
  roe/ViewInTree(child, view)

roe/ViewInTree(root, view) :-
  roe/ViewSecondChild(root, child),
  roe/ViewInTree(child, view)

roe/SessionLeafView(session, view) :-
  roe/SessionFrame(session, frame),
  roe/FrameRootView(frame, root),
  roe/ViewInTree(root, view),
  roe/ViewBuffer(view, buffer)

roe/VisibleBuffer(session, buffer) :-
  roe/SessionLeafView(session, view),
  roe/ViewBuffer(view, buffer)

roe/ArgumentCandidate(:visible_views, actor, session, view, name) :-
  roe/SessionActor(session, actor),
  roe/SessionLeafView(session, view),
  roe/ViewBuffer(view, buffer),
  roe/BufferName(buffer, name)

roe/EffectiveMajorMode(buffer, mode) :-
  roe/BufferMajorMode(buffer, mode),
  roe/EnabledMode(mode)

roe/EffectiveModeHook(buffer, hook, precedence) :-
  roe/BufferMajorMode(buffer, mode),
  roe/EnabledMode(mode),
  roe/ModeHook(mode, hook, precedence)

roe/EffectiveModeHook(buffer, hook, precedence) :-
  roe/BufferMinorMode(buffer, mode),
  roe/EnabledMode(mode),
  roe/ModeHook(mode, hook, precedence)

roe/LocalFaceAttribute(face, attribute) :-
  roe/FaceAttribute(face, attribute, value)

roe/EffectiveFaceAttribute(face, attribute, value) :-
  roe/FaceAttribute(face, attribute, value)

roe/EffectiveFaceAttribute(face, attribute, value) :-
  roe/FaceParent(face, parent),
  roe/EffectiveFaceAttribute(parent, attribute, value),
  not roe/LocalFaceAttribute(face, attribute)

roe/EffectiveSyntaxRule(buffer, mode, kind, pattern, precedence) :-
  roe/BufferMajorMode(buffer, mode),
  roe/EnabledMode(mode),
  roe/SyntaxRule(mode, kind, pattern, precedence)

roe/EffectiveSyntaxRule(buffer, mode, kind, pattern, precedence) :-
  roe/BufferMinorMode(buffer, mode),
  roe/EnabledMode(mode),
  roe/SyntaxRule(mode, kind, pattern, precedence)

roe/LocalConfiguration(scope, key) :-
  roe/Configuration(scope, key, value)

roe/EffectiveConfiguration(scope, key, value) :-
  roe/Configuration(scope, key, value)

roe/EffectiveConfiguration(scope, key, value) :-
  roe/ConfigurationParent(scope, parent),
  roe/EffectiveConfiguration(parent, key, value),
  not roe/LocalConfiguration(scope, key)

assert Delegates(#roe/global_map, #roe/keymap, 0)
assert Delegates(#roe/other_window, #roe/command, 0)
assert Delegates(#roe/fundamental_mode, #roe/mode, 0)
assert Delegates(#roe/default_face, #roe/face, 0)
assert Delegates(#roe/core_package, #roe/package, 0)

assert roe/Command(#roe/other_window)
assert roe/CommandSelector(#roe/other_window, :roe/other_window)
assert roe/CommandSummary(#roe/other_window, "Select the next logical view")
assert roe/CommandArgument(#roe/other_window, 0, :window, :logical_view)
assert roe/ArgumentPrompt(#roe/other_window, 0, "Window")
assert roe/ArgumentCompletion(#roe/other_window, 0, :visible_views)
assert roe/Keymap(#roe/global_map)
assert roe/KeyBinding(#roe/global_map, "C-x o", #roe/other_window, 100)
assert roe/MajorMode(#roe/fundamental_mode)
assert roe/ModeName(#roe/fundamental_mode, "fundamental")
assert roe/ModeKeymap(#roe/fundamental_mode, #roe/global_map, 50)
assert roe/ModeHook(#roe/fundamental_mode, :invalidate_syntax, 100)
assert roe/Face(#roe/default_face)
assert roe/FaceName(#roe/default_face, "default")
assert roe/FaceAttribute(#roe/default_face, :foreground, "inherit")
assert roe/Package(#roe/core_package)
assert roe/PackageUnit(#roe/core_package, :roe/core)
assert roe/PackageEnabled(#roe/core_package, true)
assert roe/PackageCommand(#roe/core_package, #roe/other_window)
assert roe/PackageKeymap(#roe/core_package, #roe/global_map)
assert roe/PackageMode(#roe/core_package, #roe/fundamental_mode)

assert RoleCanRead(#roe/editor_role, :roe/ActiveView)
assert RoleCanRead(#roe/editor_role, :roe/SessionActor)
assert RoleCanRead(#roe/editor_role, :roe/ViewBuffer)
assert RoleCanRead(#roe/editor_role, :roe/ViewCursor)
assert RoleCanRead(#roe/editor_role, :roe/LogicalBuffer)
assert RoleCanRead(#roe/editor_role, :roe/BufferName)
assert RoleCanRead(#roe/editor_role, :roe/CanUseBuffer)
assert RoleCanRead(#roe/editor_role, :roe/CanRequestService)
assert RoleCanRead(#roe/editor_role, :roe/EffectiveSessionKeymap)
assert RoleCanRead(#roe/editor_role, :roe/EffectiveBinding)
assert RoleCanRead(#roe/editor_role, :roe/KeyPrefix)
assert RoleCanRead(#roe/editor_role, :roe/NativeBinding)
assert RoleCanRead(#roe/editor_role, :roe/NativeEditingAction)
assert RoleCanRead(#roe/editor_role, :roe/PromptState)
assert RoleCanRead(#roe/editor_role, :roe/PromptLast)
assert RoleCanRead(#roe/editor_role, :roe/FileCandidate)
assert RoleCanRead(#roe/editor_role, :roe/CommandSelector)
assert RoleCanRead(#roe/editor_role, :roe/CommandName)
assert RoleCanRead(#roe/editor_role, :roe/CommandHostAction)
assert RoleCanRead(#roe/editor_role, :roe/CommandArgument)
assert RoleCanRead(#roe/editor_role, :roe/ArgumentPrompt)
assert RoleCanRead(#roe/editor_role, :roe/ArgumentCompletion)
assert RoleCanRead(#roe/editor_role, :roe/ArgumentCandidate)
assert RoleCanRead(#roe/editor_role, :roe/DiscoverableCommand)
assert RoleCanRead(#roe/editor_role, :roe/NextView)
assert RoleCanRead(#roe/editor_role, :roe/SessionLeafView)
assert RoleCanRead(#roe/editor_role, :roe/EffectiveModeHook)
assert RoleCanRead(#roe/editor_role, :roe/EffectiveMajorMode)
assert RoleCanRead(#roe/editor_role, :roe/ModeName)
assert RoleCanRead(#roe/editor_role, :roe/FaceName)
assert RoleCanRead(#roe/editor_role, :roe/Face)
assert RoleCanRead(#roe/editor_role, :roe/EffectiveFaceAttribute)
assert RoleCanRead(#roe/editor_role, :roe/EffectiveSyntaxRule)
assert RoleCanRead(#roe/editor_role, :roe/EffectiveConfiguration)
assert RoleCanWrite(#roe/editor_role, :roe/ActiveView)
assert RoleCanWrite(#roe/editor_role, :roe/ViewCursor)
assert RoleCanWrite(#roe/editor_role, :roe/PromptState)
assert RoleCanWrite(#roe/editor_role, :roe/PromptLast)
assert RoleCanWrite(#roe/editor_role, :roe/FileCandidate)
assert RoleCanInvoke(#roe/editor_role, :roe/dispatch_key)
assert RoleCanInvoke(#roe/editor_role, :roe/other_window)
assert RoleCanInvoke(#roe/editor_role, :roe/acquire_argument)
assert RoleCanInvoke(#roe/editor_role, :roe/accept_argument_candidate)
assert RoleCanInvoke(#roe/editor_role, :roe/prompt_candidates)
assert RoleCanInvoke(#roe/editor_role, :roe/refresh_prompt)
assert RoleCanInvoke(#roe/editor_role, :roe/prompt_key)
assert RoleCanInvoke(#roe/editor_role, :roe/list_length)
assert RoleCanInvoke(#roe/editor_role, :roe/start_file_prompt)
assert RoleCanInvoke(#roe/editor_role, :roe/start_search)
assert RoleCanInvoke(#roe/editor_role, :roe/refresh_search)
assert RoleCanInvoke(#roe/editor_role, :roe/search_prompt_key)
assert RoleCanInvoke(#roe/editor_role, :roe/publish_policy)
assert RoleCanEffect(#roe/editor_role)
assert roe/RoleCanRequestService(#roe/editor_role, :text_read)
assert roe/RoleCanRequestService(#roe/editor_role, :text_write)
assert roe/RoleCanRequestService(#roe/editor_role, :layout_validate)
assert roe/RoleCanRequestService(#roe/editor_role, :file_read)
assert roe/RoleCanRequestService(#roe/editor_role, :file_write)
assert roe/RoleCanRequestService(#roe/editor_role, :clipboard_read)
assert roe/RoleCanRequestService(#roe/editor_role, :clipboard_write)
assert roe/RoleCanRequestService(#roe/editor_role, :clock_read)
assert roe/RoleCanRequestService(#roe/editor_role, :process_spawn)
assert roe/RoleCanRequestService(#roe/editor_role, :watch_register)
assert roe/RoleCanRequestService(#roe/editor_role, :watch_unregister)

verb roe/other_window(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  let current = one roe/ActiveView(session, ?view)
  if current == nothing
    return :no_active_view
  end
  let next = one roe/NextView(current, ?view)
  if next == nothing
    return :no_next_view
  end
  roe/SessionLeafView(session, next) || return :invalid_next_view
  retract roe/ActiveView(session, current)
  assert roe/ActiveView(session, next)
  emit(session, {:kind -> :presentation_invalidated, :view -> next})
  return next
end

verb roe/dispatch_key(actor, session, sequence @ #string)
  roe/publish_policy(actor, session)
  let native = one roe/NativeBinding(sequence, ?action, ?precedence)
  if native != nothing
    if native[:action] == :indent
      let width = one roe/EffectiveConfiguration(#roe/core_configuration, :tab_width, ?width)
      if width == nothing
        width = 4
      end
      let text = ""
      let count = 0
      while count < width
        text = string_concat(text, " ")
        count = count + 1
      end
      emit(session, {:kind -> :native_action, :action -> :insert_text, :text -> text})
    else
      emit(session, {:kind -> :native_action, :action -> native[:action]})
    end
    if roe/NativeEditingAction(native[:action])
      let view = one roe/ActiveView(session, ?view)
      let buffer = one roe/ViewBuffer(view, ?buffer)
      for hook in roe/EffectiveModeHook(buffer, ?hook, ?precedence)
        emit(session, {:kind -> :host_action, :action -> hook[:hook], :view -> view})
      end
    end
    return :handled
  end
  let selected = nothing
  let selected_precedence = -2147483648
  let ambiguous = false
  for active in roe/EffectiveSessionKeymap(session, ?keymap, ?session_precedence)
    for binding in roe/EffectiveBinding(active[:keymap], sequence, ?command, ?precedence)
      let precedence = active[:session_precedence] + binding[:precedence]
      if selected == nothing || precedence > selected_precedence
        selected = binding[:command]
        selected_precedence = precedence
        ambiguous = false
      elseif precedence == selected_precedence && selected != binding[:command]
        ambiguous = true
      end
    end
  end
  if selected == nothing
    if roe/KeyPrefix(sequence)
      return :prefix
    end
    if string_len(sequence) == 1
      emit(session, {:kind -> :native_action, :action -> :insert_text, :text -> sequence})
      let view = one roe/ActiveView(session, ?view)
      let buffer = one roe/ViewBuffer(view, ?buffer)
      for hook in roe/EffectiveModeHook(buffer, ?hook, ?precedence)
        emit(session, {:kind -> :host_action, :action -> hook[:hook], :view -> view})
      end
      return :handled
    end
    return :unbound
  end
  if ambiguous
    return :ambiguous
  end
  let selector = one roe/CommandSelector(selected, ?selector)
  if selector == nothing
    return :missing_selector
  end
  return invoke(selector, {:actor -> actor, :session -> session})
end

// Return either a supplied value or the declarative prompt/completion request
// that a Mica-owned minibuffer will realize in Phase 5.
verb roe/acquire_argument(actor, session, command, position, supplied)
  roe/SessionActor(session, actor) || return :not_session_actor
  roe/DiscoverableCommand(actor, command) || return :not_discoverable
  if supplied != nothing
    return {:kind -> :argument_value, :value -> supplied}
  end
  let argument = one roe/CommandArgument(command, position, ?name, ?value_kind)
  if argument == nothing
    return :missing_argument
  end
  let prompt = one roe/ArgumentPrompt(command, position, ?prompt)
  if prompt == nothing
    return :missing_prompt
  end
  let completion = one roe/ArgumentCompletion(command, position, ?selector)
  return {:kind -> :argument_required, :name -> argument[:name], :value_kind -> argument[:value_kind], :prompt -> prompt, :completion -> completion}
end

// Validate a completion against the command's declared provider rather than
// accepting an arbitrary UI-supplied logical identity.
verb roe/accept_argument_candidate(actor, session, command, position, candidate)
  roe/SessionActor(session, actor) || return :not_session_actor
  roe/DiscoverableCommand(actor, command) || return :not_discoverable
  let completion = one roe/ArgumentCompletion(command, position, ?selector)
  if completion == nothing
    return :missing_completion
  end
  let selected = one roe/ArgumentCandidate(completion, actor, session, candidate, ?label)
  if selected == nothing
    return :invalid_candidate
  end
  return {:kind -> :argument_value, :value -> candidate, :label -> selected}
end
