// Markdown source editing policy. Whitespace is document structure, not layout.
make_identity(:roe/markdown_package)
make_identity(:roe/markdown_mode)
make_identity(:roe/markdown_map)
make_identity(:roe/enable_markdown_mode)
make_identity(:roe/markdown_insert_indent)
make_relation(:roe/MarkdownBuffer, 1)
assert RoleCanRead(#roe/editor_role, :roe/MarkdownBuffer)
assert roe/Package(#roe/markdown_package)
assert roe/PackageUnit(#roe/markdown_package, :roe/markdown)
assert roe/PackageEnabled(#roe/markdown_package, true)
assert Delegates(#roe/markdown_mode, #roe/mode, 0)
assert roe/MajorMode(#roe/markdown_mode)
assert roe/ModeName(#roe/markdown_mode, "markdown")
assert roe/PackageMode(#roe/markdown_package, #roe/markdown_mode)
assert roe/Keymap(#roe/markdown_map)
assert roe/PackageKeymap(#roe/markdown_package, #roe/markdown_map)
assert roe/KeymapParent(#roe/markdown_map, #roe/global_map)
assert roe/ModeKeymap(#roe/markdown_mode, #roe/markdown_map, 200)
assert roe/ModeHook(#roe/markdown_mode, :roe/invalidate_syntax_hook, 100)
assert roe/SyntaxRule(#roe/markdown_mode, :word, "[[:alnum:]_]", 200)
assert roe/Configuration(#roe/markdown_mode, :indent_width, 2)
assert roe/ConfigurationParent(#roe/markdown_mode, #roe/core_configuration)

roe/MarkdownBuffer(buffer) :-
  roe/BufferFileExtension(buffer, "md")
roe/MarkdownBuffer(buffer) :-
  roe/BufferFileExtension(buffer, "markdown")
roe/MarkdownBuffer(buffer) :-
  roe/BufferFileExtension(buffer, "mdown")
roe/BufferMajorMode(buffer, #roe/markdown_mode) :-
  roe/MarkdownBuffer(buffer),
  not roe/BufferHasModeOverride(buffer)

assert roe/SyntaxParser(#roe/markdown_mode, :markdown, "(atx_heading) @heading\n(setext_heading) @heading\n(pipe_table_header) @heading\n[(atx_h1_marker) (atx_h2_marker) (atx_h3_marker) (atx_h4_marker) (atx_h5_marker) (atx_h6_marker) (setext_h1_underline) (setext_h2_underline) (thematic_break) (pipe_table_delimiter_row)] @marker\n[(list_marker_plus) (list_marker_minus) (list_marker_star) (list_marker_dot) (list_marker_parenthesis) (task_list_marker_checked) (task_list_marker_unchecked)] @list\n(block_quote_marker) @quote\n[(link_destination) (link_label)] @link\n[(fenced_code_block) (indented_code_block) (html_block)] @code\n(fenced_code_block_delimiter) @marker\n(info_string) @marker")
assert roe/SyntaxInjection(#roe/markdown_mode, :markdown_inline, "[(inline) (pipe_table_cell)] @content", "(emphasis) @emphasis\n(strong_emphasis) @strong\n(strikethrough) @strike\n[(link_text) (image_description) (link_label) (link_destination) (uri_autolink) (email_autolink)] @link\n[(code_span) (html_tag)] @code\n[(backslash_escape) (hard_line_break)] @escape")
// No automatic reindentation rules: list nesting, code indentation, and hard
// breaks are user-authored structure. Enter copies the previous leading whitespace.

make_identity(:roe/markdown_heading_face)
assert roe/Face(#roe/markdown_heading_face)
assert roe/FaceName(#roe/markdown_heading_face, "markdown-heading")
assert roe/FaceAttribute(#roe/markdown_heading_face, :foreground, "#569cd6")
assert roe/FaceAttribute(#roe/markdown_heading_face, :weight, "bold")
assert roe/SyntaxHighlightRule(#roe/markdown_mode, :heading, #roe/markdown_heading_face, 200)

make_identity(:roe/markdown_marker_face)
assert roe/Face(#roe/markdown_marker_face)
assert roe/FaceName(#roe/markdown_marker_face, "markdown-marker")
assert roe/FaceAttribute(#roe/markdown_marker_face, :foreground, "#808080")
assert roe/SyntaxHighlightRule(#roe/markdown_mode, :marker, #roe/markdown_marker_face, 200)

make_identity(:roe/markdown_list_face)
