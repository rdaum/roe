assert roe/FaceName(#roe/markdown_code_face, "markdown-code")
assert roe/FaceAttribute(#roe/markdown_code_face, :foreground, "#dcdcaa")
assert roe/SyntaxHighlightRule(#roe/markdown_mode, :code, #roe/markdown_code_face, 200)

make_identity(:roe/markdown_emphasis_face)
assert roe/Face(#roe/markdown_emphasis_face)
assert roe/FaceName(#roe/markdown_emphasis_face, "markdown-emphasis")
assert roe/FaceAttribute(#roe/markdown_emphasis_face, :foreground, "#d4d4d4")
assert roe/FaceAttribute(#roe/markdown_emphasis_face, :slant, "italic")
assert roe/SyntaxHighlightRule(#roe/markdown_mode, :emphasis, #roe/markdown_emphasis_face, 200)

make_identity(:roe/markdown_strong_face)
assert roe/Face(#roe/markdown_strong_face)
assert roe/FaceName(#roe/markdown_strong_face, "markdown-strong")
assert roe/FaceAttribute(#roe/markdown_strong_face, :foreground, "#d4d4d4")
assert roe/FaceAttribute(#roe/markdown_strong_face, :weight, "bold")
assert roe/SyntaxHighlightRule(#roe/markdown_mode, :strong, #roe/markdown_strong_face, 200)

make_identity(:roe/markdown_strike_face)
assert roe/Face(#roe/markdown_strike_face)
assert roe/FaceName(#roe/markdown_strike_face, "markdown-strike")
assert roe/FaceAttribute(#roe/markdown_strike_face, :foreground, "#808080")
assert roe/SyntaxHighlightRule(#roe/markdown_mode, :strike, #roe/markdown_strike_face, 200)

make_identity(:roe/markdown_escape_face)
assert roe/Face(#roe/markdown_escape_face)
assert roe/FaceName(#roe/markdown_escape_face, "markdown-escape")
assert roe/FaceAttribute(#roe/markdown_escape_face, :foreground, "#c586c0")
assert roe/SyntaxHighlightRule(#roe/markdown_mode, :escape, #roe/markdown_escape_face, 200)

assert Delegates(#roe/enable_markdown_mode, #roe/command, 0)
assert roe/Command(#roe/enable_markdown_mode)
assert roe/CommandSelector(#roe/enable_markdown_mode, :roe/enable_markdown_mode)
assert roe/CommandName(#roe/enable_markdown_mode, "markdown-mode")
assert roe/CommandSummary(#roe/enable_markdown_mode, "Use Markdown editing policy in the active buffer")
assert roe/PackageCommand(#roe/markdown_package, #roe/enable_markdown_mode)
assert RoleCanInvoke(#roe/editor_role, :roe/enable_markdown_mode)

verb roe/enable_markdown_mode(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  let exactly {:view -> view} = roe/ActiveView(session, ?view)
  let exactly {:buffer -> buffer} = roe/ViewBuffer(view, ?buffer)
  roe/CanUseBuffer(actor, buffer) || return :buffer_denied
  retract roe/BufferModeOverride(buffer, _)
  assert roe/BufferModeOverride(buffer, #roe/markdown_mode)
  roe/publish_policy(actor, session)
  return :ok
end

assert Delegates(#roe/markdown_insert_indent, #roe/command, 0)
assert roe/Command(#roe/markdown_insert_indent)
assert roe/CommandSelector(#roe/markdown_insert_indent, :roe/markdown_insert_indent)
assert roe/CommandName(#roe/markdown_insert_indent, "markdown-insert-indent")
assert roe/CommandSummary(#roe/markdown_insert_indent, "Insert one configured indentation unit")
assert roe/PackageCommand(#roe/markdown_package, #roe/markdown_insert_indent)
assert RoleCanInvoke(#roe/editor_role, :roe/markdown_insert_indent)
assert roe/KeyBinding(#roe/markdown_map, "Tab", #roe/markdown_insert_indent, 2000)
assert roe/KeyBinding(#roe/markdown_map, "⏎", #roe/newline_and_indent, 2000)

verb roe/markdown_insert_indent(actor, session)
  roe/SessionActor(session, actor) || return :not_session_actor
  roe/CanRequestService(actor, :text_write) || return :text_write_denied
  let exactly {:view -> view} = roe/ActiveView(session, ?view)
  let exactly {:buffer -> buffer} = roe/ViewBuffer(view, ?buffer)
  roe/CanUseBuffer(actor, buffer) || return :buffer_denied
  let exactly {:width -> width} = roe/EffectiveConfiguration(#roe/markdown_mode, :indent_width, ?width)
  width >= 1 && width <= 16 || raise E_INVARG, "indentation width must be between 1 and 16"
  let text = ""
  let count = 0
  while count < width
    text = string_concat(text, " ")
    count = count + 1
  end
  emit(session, {:kind -> :native_action, :action -> :insert_text, :text -> text})
  roe/emit_edit_hooks(actor, session)
  return :ok
end
